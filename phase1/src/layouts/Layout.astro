---
import '../styles/global.css';
import '@fontsource-variable/bodoni-moda';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
const { title, description = '', current = '', preload = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{title}</title>
{description && <meta name="description" content={description} />}
{preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}

</head>
<body>

<nav class="nav" id="nav">
  <div class="container">
    <a class="wordmark" href="/index.html">Suites With Keith</a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <div class="nav-links" id="nav-links">
      <a href="/hotels/cosme-paros.html" aria-current={current === 'hotels' ? 'page' : undefined}>The Index</a>
      <a href="/index.html#collection">The Collections</a>
      <a href="/compare/cosme-vs-parilio.html" aria-current={current === 'compare' ? 'page' : undefined}>Rankings</a>
      <a href="/guides/paros.html" aria-current={current === 'guides' ? 'page' : undefined}>Guides</a>
      <a href="/about.html" aria-current={current === 'about' ? 'page' : undefined}>About</a>
    </div>
    <span class="preview-chip">Phase 1 · Preview</span>
  </div>
</nav>

<slot />

<footer class="site">
  <div class="container foot-grid">
    <div>
      <a class="wordmark" href="/index.html">Suites With Keith</a>
      <p style="margin-top:14px;" class="read">Better rooms. Better trips. Hotel recommendations from someone who has stood in the rooms &mdash; booking is complimentary; the judgment comes with it.</p>
    </div>
    <div>
      <p class="col-h">Get in touch</p>
      <div class="links">
        <a href="mailto:keith.pence@fora.travel">keith.pence@fora.travel</a>
        <a href="https://instagram.com/suiteswithkeith" rel="noopener">@suiteswithkeith</a>
      </div>
    </div>
    <div>
      <p class="col-h">Preview</p>
      <div class="links">
        <a href="/index.html">Home</a>
        <a href="/hotels/cosme-paros.html">Hotel record &middot; Cosme</a>
        <a href="/compare/cosme-vs-parilio.html">Head-to-head</a>
        <a href="/guides/paros.html">Guide &middot; Paros</a>
        <a href="/about.html">About</a>
      </div>
    </div>
  </div>
</footer>

<a href="#inquire" class="btn sticky-cta">Tell me where you&rsquo;re going</a>

<script>
  // Nav disclosure
  const t = document.getElementById('nav-toggle');
  const nav = document.getElementById('nav');
  t?.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    t.setAttribute('aria-expanded', String(open));
  });

  // Reveal once, containers only, capped stagger
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach((el, i) => {
    el.style.transitionDelay = Math.min(i % 5, 4) * 60 + 'ms';
    io.observe(el);
  });

  // One-field ask: progressive disclosure + fetch submit
  const form = document.querySelector('.inquire-form');
  if (form) {
    const step2 = form.querySelector('.step2');
    const when = form.querySelector('input[name="travel_dates"]');
    const status = form.querySelector('.status');
    const btn = form.querySelector('button[type="submit"]');
    const reveal = () => { if (step2 && step2.hidden) step2.hidden = false; };
    if (step2 && when) {
      step2.hidden = true;
      when.addEventListener('focus', reveal);
      when.addEventListener('input', reveal);
      form.addEventListener('invalid', reveal, true);
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      btn.disabled = true;
      status.textContent = '';
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then((r) => {
          if (!r.ok) throw new Error();
          form.reset();
          form.classList.add('done');
          status.textContent = 'Got it. You’ll hear from me, not an autoresponder.';
        })
        .catch(() => { status.textContent = 'That didn’t send — email me directly at keith.pence@fora.travel.'; })
        .then(() => { btn.disabled = false; });
    });
  }
</script>
</body>
</html>
