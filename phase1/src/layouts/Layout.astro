---
import '../styles/global.css';
import '@fontsource-variable/bodoni-moda';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
const { title, description = '', current = '', preload = '', canonical = '' } = Astro.props;
const canonicalPath = canonical === 'index.html' ? '' : canonical;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description} />}
{canonical && <link rel="canonical" href={'https://suiteswithkeith.com/' + canonicalPath} />}
{canonical && <meta property="og:url" content={'https://suiteswithkeith.com/' + canonicalPath} />}
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0J39101CS2"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-0J39101CS2');
</script>
<slot name="head" />
</head>
<body>

<nav class="nav" id="nav">
  <div class="container">
    <a class="wordmark" href="/index.html">Suites With Keith</a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <div class="nav-links" id="nav-links">
      <a href="/services.html">Services</a>
      <a href="/collections.html" data-gtag-label="collections" data-gtag-location="nav">The Collections</a>
      <a href="/destination-guides.html" data-gtag-label="destination_guides" data-gtag-location="nav">Destination Guides</a>
      <a href="/rankings.html" data-gtag-label="keiths_rankings" data-gtag-location="nav">Keith's Rankings</a>
      <a href="/about.html" aria-current={current === 'about' ? 'page' : undefined}>About</a>
    </div>
  </div>
</nav>

<slot />

<footer class="site">
  <div class="container foot-grid">
    <div>
      <a class="wordmark" href="/index.html">Suites With Keith</a>
      <p style="margin-top:14px;" class="read">Better rooms. Better trips. Hotel recommendations from someone who has stood in the rooms &mdash; booking is complimentary; the judgment comes with it.</p>
    </div>
    <div>
      <p class="col-h">Get in touch</p>
      <div class="links">
        <a href="mailto:keith.pence@fora.travel">keith.pence@fora.travel</a>
        <a href="https://instagram.com/suiteswithkeith" rel="noopener">@suiteswithkeith</a>
      </div>
    </div>
    <div>
      <p class="col-h">Explore</p>
      <div class="links">
        <a href="/collections.html">The Collections</a>
        <a href="/destination-guides.html">Destination Guides</a>
        <a href="/rankings.html">Keith&rsquo;s Rankings</a>
        <a href="/privacy.html">Privacy Policy</a>
      </div>
    </div>
  </div>
  <div class="container" style="margin-top:56px; padding-top:36px; border-top:1px solid var(--hairline);">
    <p class="col-h">Get first access to future issues</p>
    <div class="beehiiv-wrap">
      <script is:inline async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="02920925-682b-4b12-a526-e4fe0939610c"></script>
      <p style="margin-top:10px;"><a href="/subscriber-welcome.html" style="font-size:.85rem;">Just subscribed? Continue to your welcome page &rarr;</a></p>
    </div>
  </div>
</footer>

<a href="#inquire" class="btn sticky-cta" data-gtag-label="start_planning" data-gtag-location="sticky_mobile">Tell me where you&rsquo;re going</a>

<script>
  // Nav disclosure
  const t = document.getElementById('nav-toggle');
  const nav = document.getElementById('nav');
  t?.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    t.setAttribute('aria-expanded', String(open));
  });

  // Reveal once, containers only, capped stagger
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('on');
      io.unobserve(e.target);
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach((el, i) => {
    el.style.transitionDelay = Math.min(i % 5, 4) * 60 + 'ms';
    io.observe(el);
  });

  // One-field ask: progressive disclosure + fetch submit
  const form = document.querySelector('.inquire-form');
  if (form) {
    const step2 = form.querySelector('.step2');
    const when = form.querySelector('input[name="travel_dates"]');
    const status = form.querySelector('.status');
    const btn = form.querySelector('button[type="submit"]');
    const reveal = () => { if (step2 && step2.hidden) step2.hidden = false; };
    if (step2 && when) {
      step2.hidden = true;
      when.addEventListener('focus', reveal);
      when.addEventListener('input', reveal);
      form.addEventListener('invalid', reveal, true);
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      btn.disabled = true;
      status.textContent = '';
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then((r) => {
          if (!r.ok) throw new Error();
          form.reset();
          form.classList.add('done');
          status.textContent = 'Got it. You’ll hear from me, not an autoresponder.';
        })
        .catch(() => { status.textContent = 'That didn’t send — email me directly at keith.pence@fora.travel.'; })
        .then(() => { btn.disabled = false; });
    });
  }
</script>
<script is:inline defer src="/js/swk-events.js"></script>
</body>
</html>
