---
// FAQ accordion + FAQPage schema for the ranking pages, from data/rankingfaqs.json.
// tools/add_ranking_faq.py injects the same markup into the built HTML.
import faqs from '../data/rankingfaqs.json';
const { slug } = Astro.props;
const entry = faqs[slug];
const plain = (s) => s.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&rsquo;/g, '’').replace(/\s+/g, ' ').trim();
const schema = entry && JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.faq.map(([q, a]) => ({ '@type': 'Question', name: plain(q), acceptedAnswer: { '@type': 'Answer', text: plain(a) } })),
}).replace(/<\//g, '<\\/');
const css = `.vs-faq details{border-top:1px solid var(--hairline);padding:18px 0}.vs-faq details:last-child{border-bottom:1px solid var(--hairline)}.vs-faq summary{cursor:pointer;font-family:var(--display);font-size:1.344rem;list-style:none;position:relative;padding-right:28px}.vs-faq summary::-webkit-details-marker{display:none}.vs-faq summary::after{content:"+";position:absolute;right:0;top:0;color:var(--brass);font-family:var(--body)}.vs-faq details[open] summary::after{content:"\\2013"}.vs-faq details p{margin-top:12px;max-width:62ch}`;
---
{entry && (
  <Fragment set:html={`<script type="application/ld+json">${schema}</script><style>${css}</style>`} />
  <section class="section" id="faq" style="scroll-margin-top:70px;">
    <div class="container" style="max-width:820px;">
      <div class="sec-head reveal"><span class="eyebrow">Before you ask</span><h2 class="display-l" set:html={entry.title} /></div>
      <div class="vs-faq reveal">
        {entry.faq.map(([q, a]) => (
          <details><summary set:html={q} /><p class="body-2" set:html={a} /></details>
        ))}
      </div>
    </div>
  </section>
)}
