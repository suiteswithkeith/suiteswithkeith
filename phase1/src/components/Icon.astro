---
// Icon: thin-stroke glyphs for the few places a UI needs one. No icon system beyond this set.
const paths = {
  chevronDown: 'M6 9l6 6 6-6',
  chevronRight: 'M9 18l6-6-6-6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  arrowRight: 'M5 12h14M13 6l6 6-6 6',
  check: 'M5 12l5 5L19 7',
};
const { name = 'chevronDown', size = 20, strokeWidth = 1.75, label } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" stroke-width={strokeWidth}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <path d={paths[name] ?? paths.chevronDown} />
</svg>
