---
// One villa: name, take, highlights and specs, then a swipeable gallery.
// villa.photos rows are [file under /images/hotels/, width, height, alt, caption, isFloorPlan?].
const { villa: v, index, hotel } = Astro.props;
---
<section class="section villa" id={v.id} style="scroll-margin-top:70px;">
  <div class="container">
    <div class="villa-head reveal">
      <div>
        <span class="eyebrow">{`0${index + 1}`} &middot; <span set:html={v.kicker} /></span>
        <h2 class="display-l" style="margin-top:10px;" set:html={v.name} />
        <p class="body-2 take" set:html={v.take} />
        {v.features?.length > 0 && <ul class="feat">{v.features.map((f) => <li set:html={f} />)}</ul>}
      </div>
      <dl class="kv">
        {v.specs.map(([k, val]) => <div class="kv-row"><dt set:html={k} /><dd set:html={val} /></div>)}
      </dl>
    </div>
    <div class="gallery reveal" data-gallery>
      <div class="track">
        {v.photos.map(([src, w, h, alt, cap, plan]) => (
          <figure class={plan ? 'plan' : ''}><img src={`/images/hotels/${src}`} alt={`${alt}, ${hotel}`} width={w} height={h} loading="lazy" decoding="async" /><figcaption>{cap}</figcaption></figure>
        ))}
      </div>
      {v.photos.length > 1 && (
        <div class="gctl">
          <button type="button" class="gbtn" data-dir="-1" aria-label={`Previous ${v.name} photo`}>&larr;</button>
          <span class="gcount"><span data-i>1</span> / {v.photos.length}</span>
          <button type="button" class="gbtn" data-dir="1" aria-label={`Next ${v.name} photo`}>&rarr;</button>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-gallery]').forEach((g) => {
    const track = g.querySelector('.track');
    const figs = [...track.children];
    const idx = g.querySelector('[data-i]');
    const current = () => {
      let best = 0, d = Infinity;
      figs.forEach((f, i) => { const x = Math.abs(f.offsetLeft - track.offsetLeft - track.scrollLeft); if (x < d) { d = x; best = i; } });
      return best;
    };
    g.querySelectorAll('.gbtn').forEach((b) => b.addEventListener('click', () => {
      const n = Math.min(figs.length - 1, Math.max(0, current() + Number(b.dataset.dir)));
      track.scrollTo({ left: figs[n].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    }));
    if (idx) track.addEventListener('scroll', () => { idx.textContent = String(current() + 1); }, { passive: true });
  });
</script>

<style>
  .villa { border-top: 1px solid var(--hairline); }
  .villa-head { display: grid; gap: 32px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) { .villa-head { grid-template-columns: 1.3fr 1fr; gap: 64px; } }
  .villa-head > * { min-width: 0; }
  .take { margin-top: 16px; max-width: 56ch; }
  .feat { margin-top: 18px; padding-left: 1.1em; max-width: 56ch; }
  .feat li { margin-top: 6px; line-height: 1.55; }
  .gallery { margin-top: 36px; }
  .track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .track::-webkit-scrollbar { display: none; }
  .track figure { flex: 0 0 88%; margin: 0; scroll-snap-align: start; }
  @media (min-width: 760px) { .track figure { flex-basis: min(74%, 860px); } }
  .track img { width: 100%; aspect-ratio: 3/2; object-fit: cover; display: block; }
  .track figure.plan img { object-fit: contain; background: var(--lime); }
  figcaption { font-family: var(--font-stamp); font-size: .68rem; color: var(--ash); margin-top: 10px; letter-spacing: .04em; }
  .gctl { display: flex; align-items: center; gap: 16px; margin-top: 16px; }
  .gbtn { width: 44px; height: 44px; border: 1px solid var(--hairline-firm); background: transparent; color: var(--ink); font-size: 1.1rem; cursor: pointer; }
  @media (hover:hover) { .gbtn:hover { background: var(--lime); } }
  .gcount { font-size: .8rem; letter-spacing: .1em; color: var(--ash); }
</style>
