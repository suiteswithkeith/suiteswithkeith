---
import Layout from '../layouts/Layout.astro';
import VillaSection from '../components/VillaSection.astro';

const villas = [
  {
    id: 'syros', name: 'Syros Three-Bedroom Villa', kicker: 'For a family · 3 bedrooms',
    take: 'Built for entertaining: an infinity pool with its own cabana above Kalo Livadi Bay, an outdoor living room with a bar and fireplace, and room for four adults and two kids.',
    specs: [['Bedrooms', '<b>3</b>: two king and two double beds, crib on request'], ['Sleeps', '6 adults, or 4 adults and 2 children'], ['Size', '177 m&sup2; (1,905 sq ft)'], ['Pool', 'Infinity pool with a private cabana, sunbeds and an outdoor shower'], ['Bathrooms', 'Three full bathrooms plus a guest powder room']],
    features: ['An outdoor living room with a dining table, bar and fireplace', 'An indoor living room with its own dining table', 'Sea views across the bay', 'The private beach and the Four Seasons kids club a short walk away'],
    photos: [
      ['four-seasons-mykonos-syros-infinity-pool.jpg', 1800, 1013, 'The Syros Villa infinity pool and cabana above Kalo Livadi Bay', 'The infinity pool and cabana above the bay'],
      ['four-seasons-mykonos-syros-outdoor-living.jpg', 1800, 988, 'The shaded outdoor living room with a marble bar and dining table at the Syros Villa', 'The outdoor living room, bar and dining table'],
      ['four-seasons-mykonos-syros-bedroom-sea-view.jpg', 1800, 1010, 'A Syros Villa bedroom opening onto a sea-view balcony', 'A bedroom with a sea-view balcony'],
      ['four-seasons-mykonos-syros-bedroom-garden.jpg', 1800, 998, 'A Syros Villa bedroom opening onto a private garden', 'A bedroom opening onto the garden'],
    ],
  },
  {
    id: 'sea-view', name: 'Two-Bedroom Sea-View Villa', kicker: 'For a small family · 2 bedrooms',
    take: 'Floor-to-ceiling glass, a terrace with a daybed and a private pool facing the sea, for two adults and two kids.',
    specs: [['Bedrooms', '<b>2</b>: one king and two double beds, sofa bed or crib'], ['Sleeps', '4 adults, or 2 adults and 2 children'], ['Size', '120 m&sup2; (1,291 sq ft)'], ['Pool', 'Private pool, facing the sea'], ['Bathrooms', 'Two full bathrooms plus a guest powder room']],
    features: ['Double sinks, a separate shower and an oval tub by the window in each bathroom', 'Floor-to-ceiling glass doors onto the terrace', 'A terrace with a daybed', 'Living and dining rooms'],
    photos: [
      ['four-seasons-mykonos-1.jpg', 1800, 1001, 'A light-filled room with sea-view balconies at Four Seasons Hotel Mykonos', 'At the hotel: Cycladic white, with the sea through every door'],
      ['four-seasons-mykonos-3.jpg', 1800, 1010, 'A marble bathroom with a freestanding tub at Four Seasons Hotel Mykonos', 'At the hotel: marble bathrooms and a soaking tub'],
      ['four-seasons-mykonos-2.jpg', 1800, 1021, 'A whitewashed terrace with loungers facing the Aegean at Four Seasons Hotel Mykonos', 'At the hotel: a terrace facing the Aegean'],
    ],
  },
];

const faq = [
  ['What is the best villa in Mykonos for families?', 'The villas at Four Seasons Hotel Mykonos are where I&rsquo;d start a family. You get a private house with your own pool, a private beach on Kalo Livadi Bay, and Four Seasons service behind you, which is still rare on Mykonos.'],
  ['How many villas does Four Seasons Mykonos have?', 'Two: the Syros Three-Bedroom Villa (177 m&sup2;, up to 6 adults, or 4 adults and 2 children) and the Two-Bedroom Sea-View Villa (120 m&sup2;, up to 4 adults, or 2 adults and 2 children). Both have a private pool.'],
  ['Does Four Seasons Mykonos have a kids club?', 'Yes. There&rsquo;s a Four Seasons kids club on property, which is a big part of why I send families here: the kids have their own program while the parents enjoy the private beach and the pools.'],
  ['Does Four Seasons Mykonos have a private beach?', 'Yes. The resort sits on a hillside above Kalo Livadi Bay on the south coast, with its own private beach below and two infinity pools facing the Aegean.'],
  ['What if the villas are booked?', 'Even the entry-level Deluxe Sea-View Rooms are around 500 square feet, large enough for a family of three. For a bigger family I&rsquo;ll look at suites and connecting options, or at the <a href="/fouquets-mykonos-villas.html">Fouquet&rsquo;s Mykonos villas</a>.'],
  ['How far is it from Mykonos Town?', 'About 20 minutes by car. I arrange drivers for dinners in Chora and private transfers from the airport or port.'],
  ['How much do the villas cost?', 'Four Seasons prices dynamically, so rates depend on your dates and availability. With only two villas, peak weeks go early, so ask me as soon as you know your dates.'],
];
---
<Layout
  canonical="four-seasons-mykonos-villas.html"
  title="Four Seasons Mykonos Villas: Private Pool Villas on a Private Beach | Suites With Keith"
  description="Keith's guide to the two villas at Four Seasons Hotel Mykonos: the Syros Three-Bedroom Villa (up to 6) and the Two-Bedroom Sea-View Villa (up to 4), each with a private pool, above a private beach on Kalo Livadi Bay. One of the best family villas in Mykonos."
  preload="/images/hotels/four-seasons-mykonos-syros-infinity-pool.jpg"
  ctaLabel="Ask about the villas"
>

<script type="application/ld+json" slot="head" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/&rsquo;/g, '’'), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '').replace(/&rsquo;/g, '’').replace(/&sup2;/g, '²') } })),
})} />

<header class="hero" style="min-height:min(78svh,720px);">
  <img class="hero-img" src="/images/hotels/four-seasons-mykonos-syros-infinity-pool.jpg" alt="The Syros Villa infinity pool and cabana above the turquoise water of Kalo Livadi Bay, Four Seasons Hotel Mykonos" width="1800" height="1012" fetchpriority="high" />
  <div class="container">
    <p class="eyebrow">Mykonos &middot; Kalo Livadi Bay</p>
    <h1 class="display-xl" style="margin-top:18px;">The Villas at Four Seasons Mykonos</h1>
    <p class="sub">Two private pool villas above a private beach, with Four Seasons service behind them. One of the best ways to bring a family to Mykonos.</p>
    <div class="hero-ctas">
      <a class="btn" href="#inquire" data-gtag-label="start_planning" data-gtag-location="hero">Ask about the villas</a>
      <a class="btn btn-ghost on-shadow" href="/hotels/four-seasons-mykonos.html" style="border-color:rgba(242,239,230,.4); color:var(--band-ink);">Read about the hotel</a>
    </div>
  </div>
</header>

<section class="section">
  <div class="container" style="max-width:860px;">
    <div class="reveal">
      <p class="deck" style="max-width:44ch;">I have a close relationship with the Four Seasons Mykonos team and have sent them clients, and the villas are what I point families to first.</p>
      <p class="body-2" style="margin-top:20px; max-width:62ch;">Four Seasons Hotel Mykonos opened in 2026 on a hillside above Kalo Livadi Bay, built like a Mykonian village with its own private beach below and two infinity pools facing the Aegean. Most Mykonos villa rentals leave you on your own for service, food and logistics. Here you get a private house and a full Four Seasons around it.</p>
      <p class="body-2" style="margin-top:14px; max-width:62ch;">There are just two villas, a three-bedroom and a two-bedroom, each with its own pool and living and dining rooms. With only two, they go early for peak summer weeks.</p>
    </div>
  </div>
</section>

{villas.map((v, n) => <VillaSection villa={v} index={n} hotel="Four Seasons Mykonos" />)}

<section class="section band on-shadow">
  <div class="container" style="max-width:860px;">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">Why it works for families</span>
    <h2 class="display-l reveal">A private house, a private beach</h2>
    <ul class="why reveal">
      <li><b>A private beach.</b> Beach days on Kalo Livadi Bay without the beach-club scramble.</li>
      <li><b>Your own pool.</b> Both villas have a private pool, and Syros has an infinity pool with its own cabana.</li>
      <li><b>A Four Seasons kids club.</b> The kids have their own program, and the parents get the beach and the spa.</li>
      <li><b>Built for families.</b> The Syros Villa sleeps four adults and two kids, and cribs are available in both villas.</li>
      <li><b>Four Seasons service.</b> Still rare on Mykonos, and it matters most with kids or a group.</li>
      <li><b>Room to grow.</b> Even the entry-level Deluxe Sea-View Rooms are around 500 square feet, so extended family can stay nearby.</li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:860px;">
    <div class="sec-head reveal">
      <span class="eyebrow">Booking through me</span>
      <h2 class="display-l">Fora perks, and someone who knows the team</h2>
    </div>
    <p class="body-2 reveal" style="max-width:62ch;">I know the Four Seasons Mykonos team and have sent them clients, so I&rsquo;ll check both villas for your dates, set up everything before you arrive and be your direct line while you&rsquo;re there. My clients receive Fora perks on eligible stays, like daily breakfast and upgrade priority, and rates are identical to booking direct.</p>
    <dl class="kv reveal" style="margin-top:24px;">
      <div class="kv-row"><dt>On the island</dt><dd>Drivers for dinners in Chora, and <a href="/mykonos-excursions.html">boat days and excursions</a></dd></div>
      <div class="kv-row"><dt>Getting there</dt><dd>Private transfers, and <a href="/private-boat-transfers.html">private boats</a> to Paros or Naxos instead of the ferry</dd></div>
      <div class="kv-row"><dt>More Mykonos villas</dt><dd><a href="/fouquets-mykonos-villas.html">Fouquet&rsquo;s Mykonos</a>, with four villas of up to seven bedrooms</dd></div>
    </dl>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container" style="max-width:820px;">
    <div class="sec-head reveal">
      <span class="eyebrow">Before you ask</span>
      <h2 class="display-l">The questions I get</h2>
    </div>
    <div class="faq reveal">
      {faq.map(([q, a]) => (
        <details>
          <summary set:html={q} />
          <p class="body-2" set:html={a} />
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section inquire band on-shadow" id="inquire" style="scroll-margin-top:70px;">
  <div class="container">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">Four Seasons Mykonos Villas</span>
    <h2 class="display-l reveal">When are you thinking?</h2>
    <p class="deck reveal" style="margin:18px auto 0; max-width:44ch;">Tell me your dates, who&rsquo;s coming and the kids&rsquo; ages. I&rsquo;ll check both villas and plan the rest of the islands around them.</p>
    <form class="inquire-form reveal" action="https://formspree.io/f/mjgnadov" method="POST">
      <input type="hidden" name="_subject" value="Four Seasons Mykonos villa inquiry" />
      <input type="hidden" name="hotel" value="Four Seasons Mykonos Villas" />
      <input type="hidden" name="page" value="four-seasons-mykonos-villas" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="step1">
        <label for="q-when" style="color:var(--band-ash);">When are you thinking?</label>
        <input id="q-when" type="text" name="travel_dates" placeholder="July 2027 · 5 nights · 6 guests" required autocomplete="off" />
      </div>
      <div class="step2">
        <label for="q-name" style="color:var(--band-ash);">And where do I send the plan?</label>
        <input id="q-name" type="text" name="name" placeholder="Name" required autocomplete="name" />
        <input id="q-email" type="email" name="email" placeholder="Email" required autocomplete="email" />
        <label for="q-details" style="margin-top:2px; color:var(--band-ash);">Anything else? Kids&rsquo; ages, occasion, the rest of the trip (optional)</label>
        <input id="q-details" type="text" name="details" placeholder="Kids 5 and 8 · then Paros and Santorini" autocomplete="off" />
      </div>
      <button type="submit" class="btn" data-gtag-label="villa_inquiry_send" data-gtag-location="villa_cta">Send</button>
      <p class="note" style="color:var(--band-ash);">Traveling within the next 30 days? You&rsquo;ll hear from me today.</p>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

</Layout>

<style>
  @media (min-width: 760px) {
      }
  .why { margin-top: 24px; padding-left: 1.1em; max-width: 62ch; }
  .why li { margin-top: 12px; line-height: 1.6; }
  .faq details { border-top: 1px solid var(--hairline); padding: 18px 0; }
  .faq details:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { cursor: pointer; font-family: var(--display); font-size: 1.344rem; list-style: none; position: relative; padding-right: 28px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; position: absolute; right: 0; top: 0; color: var(--brass); font-family: var(--body); }
  .faq details[open] summary::after { content: "\2013"; }
  .faq details p { margin-top: 12px; max-width: 62ch; }
</style>
