---
import Layout from '../layouts/Layout.astro';
import Ask from '../components/Ask.astro';
import '../styles/swk-article.css';
import body from '../data/greek-island-matrix-body.html?raw';

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: "Which island should I start with if it's my first time?", acceptedAnswer: { '@type': 'Answer', text: 'Paros. It has the best balance of food, beaches, hotels, and ease, and it connects easily to almost everything else on the matrix.' } },
    { '@type': 'Question', name: 'Is Santorini worth it?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, for two or three nights, in the right hotel, outside July and August. The caldera is genuinely one of the great sights in the Mediterranean. The mistake is staying a week.' } },
    { '@type': 'Question', name: 'How many islands in two weeks?', acceptedAnswer: { '@type': 'Answer', text: "Three, comfortably. Four if the transfers are private and you're willing to move at pace. Five is a specific kind of trip and needs to be built that way from the start." } },
    { '@type': 'Question', name: 'Do I need to rent a car?', acceptedAnswer: { '@type': 'Answer', text: 'On Milos, Serifos, Tinos, Naxos and Crete, yes. On Folegandros, Sifnos and Santorini you can manage without. On Mykonos and Paros it depends entirely on the hotel.' } },
    { '@type': 'Question', name: 'Can you book these hotels for me?', acceptedAnswer: { '@type': 'Answer', text: "Yes — that's the job. I have direct relationships with most of the properties on this page, which usually means an upgrade, breakfast, or a credit that isn't available booking direct." } },
  ],
});
---
<Layout
  canonical="greek-island-matrix.html"
  title="The Greek Island Matrix: 14 Islands, 21 Hotels, Placed Honestly"
  description="Fourteen Greek islands mapped from rustic to polished and undiscovered to well-trodden — plus the 21 hotels I'd actually book, island by island."
  preload="/images/personal/santorini-window.jpg"
  current="guides"
>

<Fragment slot="head" set:html={`<script type="application/ld+json">${faqSchema}</script>`} />

<Fragment set:html={body} />

<Ask
  subject="Inquiry — Greek Island Matrix"
  page="greek-island-matrix"
  placeholder="Two weeks, next June"
  deck="Tell me who&rsquo;s traveling and when &mdash; I&rsquo;ll tell you which islands fit, and which hotel on each."
  dark
/>

</Layout>
