      { img: '/images/tennis/burgenstock.jpg', kicker: 'Lucerne', name: 'B&uuml;rgenstock Resort', blurb: 'Alpine courts 500 meters above Lake Lucerne &mdash; the best backdrop in the sport.', href: '/hotels/burgenstock-resort-lake-lucerne.html' },
      { img: '/images/tennis/cheval-blanc-randheli.avif', kicker: 'Maldives', name: 'Cheval Blanc Randheli', blurb: 'Palm-shaded courts on a private island &mdash; morning tennis, afternoon lagoon.', href: '/hotels/cheval-blanc-randheli-maldives.html' },
    ]}],
    experiences: null,
    expCredit: 'Tennis programming comes through my partnership with <a href="https://www.luxtennis.com/" target="_blank" rel="noopener">LUX Tennis</a> &mdash; the team placing ATP- and WTA-caliber pros, clinics, and hitting partners at the world&rsquo;s finest resorts.',
    cta: 'See all eleven courts &mdash; and where I&rsquo;d stay to play them.', ctaHref: '/top-hotel-tennis-courts.html', ctaLabel: 'The full tennis ranking',
  },
];
---
<Layout
  canonical="featured-destinations.html"
  title="Featured Destinations | Suites With Keith"
  description="The places I plan most often — Italy, Paris, London, Greece, Japan, Africa and Mexico — and the hotels I'd send my own family to, with partner amenities attached."
  preload="/images/hotels/canaves-oia-1.jpg"
>

<!-- hero -->
<header class="hero" style="min-height:min(74svh,700px);">
  <img class="hero-img" src="/images/hotels/canaves-oia-1.jpg" alt="Whitewashed suites stepping down the caldera at Canaves Oia, Santorini" width="1800" height="1200" fetchpriority="high" />
  <div class="container">
    <p class="eyebrow">Featured destinations</p>
    <h1 class="display-xl">Where I plan<br><em>most often</em></h1>
    <p class="sub">The places I keep going back to &mdash; and the hotels I&rsquo;d send my own family to, with partner amenities and my advocacy attached to every booking.</p>
    <div class="hero-ctas">
      <a class="btn" href="#inquire" data-gtag-label="start_planning" data-gtag-location="hero">Tell me where you&rsquo;re going</a>
    </div>
  </div>
</header>

<!-- jump bar -->
<nav class="jump" aria-label="Destinations on this page">
  <div class="container">
    {sections.map((s) => <a href={`#${s.id}`}>{s.title === 'For the tennis traveler' ? 'Tennis' : s.title}</a>)}
  </div>
</nav>

<!-- why book here -->
<section class="section" style="padding-bottom:0;">
  <div class="container">
    <div class="adv reveal">
      <div>
        <p class="stamp plain" style="font-weight:700; color:var(--brass);">Preferred partnerships</p>
        <p>I&rsquo;m a preferred partner of Rosewood, Four Seasons, Aman, Belmond, Auberge and many of the world&rsquo;s top hotel brands &mdash; space-available upgrades, daily breakfast, property credits and VIP recognition come with your booking at no extra cost.</p>
      </div>
      <div>
        <p class="stamp plain" style="font-weight:700; color:var(--brass);">Free-night promotions</p>
        <p>Many of these properties run stay-3-pay-2 or stay-4-pay-3 offers through partner channels. I watch for them and time your booking so the promotion does the saving &mdash; the rate is never higher than booking direct.</p>
      </div>
      <div>
        <p class="stamp plain" style="font-weight:700; color:var(--brass);">Priority over the portals</p>
        <p>Partner bookings are typically prioritized ahead of credit-card travel programs like Amex or Chase when upgrades and special requests are handed out &mdash; and my direct relationships with the hotels&rsquo; teams close the rest of the gap.</p>
      </div>
    </div>
  </div>
</section>

{sections.map((s) => (
  <section class={`section${s.band ? ' band on-shadow' : ''}`} id={s.id} style="scroll-margin-top:70px;">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow">{s.eyebrow}</span>
        <h2 class="display-l">{s.title}</h2>
        <p class={s.band ? 'body-2' : 'body-2'} style="margin-top:16px; max-width:64ch;" set:html={s.intro} />
      </div>

      {s.map === 'italy' && (
        <div class="map reveal">
          <div class="map-scroll">
            <svg viewBox="60 10 600 750" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Map of Italy showing the five regions Keith plans most: Lake Como, Florence, Tuscany, Rome, and the Amalfi Coast">
              <path d="M150,112 C196,76 262,58 312,60 C338,61 350,74 356,94 C362,114 354,134 364,156 C382,198 414,240 442,286 C468,328 490,374 516,414 C534,442 560,462 584,480 C604,494 622,510 626,532 C630,554 612,562 596,553 C582,545 572,534 556,530 C540,526 524,528 512,518 C498,506 494,490 482,478 C468,464 448,462 442,476 C436,490 444,506 452,520 C464,542 474,564 478,588 C482,612 480,636 470,656 C463,670 450,682 436,677 C422,672 419,656 417,642 C414,624 413,608 402,596 C389,582 371,576 359,562 C345,546 341,524 329,508 C313,486 289,472 273,450 C253,424 245,392 235,362 C225,332 211,304 197,276 C183,248 167,222 159,192 C151,166 141,138 150,112 Z" fill="#F2EFE6" opacity="0.12"/>
              <path d="M368,706 L470,700 L428,748 Z" fill="#F2EFE6" opacity="0.10"/>
              <ellipse cx="128" cy="500" rx="34" ry="72" fill="#F2EFE6" opacity="0.10"/>
              <text x="90" y="330" font-size="12" letter-spacing="3" fill="rgba(242,239,230,0.35)">TYRRHENIAN SEA</text>
              <text x="470" y="240" font-size="12" letter-spacing="3" fill="rgba(242,239,230,0.35)">ADRIATIC</text>
              <g>
                <circle cx="282" cy="98" r="9" fill="#BE975A"/>
                <text x="300" y="94" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6">LAKE COMO</text>
                <text x="300" y="110" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)">PASSALACQUA &middot; IL SERENO &middot; MANDARIN ORIENTAL</text>
              </g>
              <g>
                <circle cx="290" cy="286" r="9" fill="#BE975A"/>
                <text x="308" y="282" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6">FLORENCE</text>
                <text x="308" y="298" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)">VILLA SAN MICHELE &middot; FOUR SEASONS &middot; LUNGARNO</text>
              </g>
              <g>
                <circle cx="300" cy="368" r="9" fill="#BE975A"/>
                <text x="282" y="364" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6" text-anchor="end">TUSCANY</text>
                <text x="282" y="380" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)" text-anchor="end">ROSEWOOD &middot; BELMOND &middot; COMO</text>
              </g>
              <g>
                <circle cx="336" cy="470" r="9" fill="#BE975A"/>
                <text x="318" y="466" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6" text-anchor="end">ROME</text>
                <text x="318" y="482" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)" text-anchor="end">DE RUSSIE &middot; EDEN &middot; ST. REGIS</text>
              </g>
              <g>
                <circle cx="422" cy="560" r="9" fill="#BE975A"/>
                <text x="440" y="556" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6">AMALFI COAST</text>
                <text x="440" y="572" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)">CARUSO &middot; IL SAN PIETRO &middot; LE SIRENUSE</text>
              </g>
            </svg>
          </div>
        </div>
      )}

      {s.map === 'greece' && (
        <div class="map reveal">
          <div class="map-scroll">
            <svg viewBox="390 30 610 610" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Map of the Cyclades showing the islands and hotels Keith plans most">
              <text x="560" y="80" font-size="13" letter-spacing="3" fill="rgba(242,239,230,0.4)">THE AEGEAN</text>
              <ellipse cx="468" cy="320" rx="15" ry="12" fill="#F2EFE6" opacity="0.16"/>
              <ellipse cx="424" cy="242" rx="10" ry="14" fill="#F2EFE6" opacity="0.16"/>
              <ellipse cx="638" cy="222" rx="12" ry="16" fill="#F2EFE6" opacity="0.16"/>
              <ellipse cx="498" cy="434" rx="9" ry="7" fill="#F2EFE6" opacity="0.16"/>
              <ellipse cx="728" cy="478" rx="12" ry="7" fill="#F2EFE6" opacity="0.16" transform="rotate(-15 728 478)"/>
              <ellipse cx="800" cy="465" rx="14" ry="11" fill="#F2EFE6" opacity="0.16"/>
              <g>
                <ellipse cx="830" cy="219" rx="17" ry="12" fill="#F2EFE6" opacity="0.9"/>
                <text x="830" y="192" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6" text-anchor="middle">MYKONOS</text>
                <text x="830" y="250" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)" text-anchor="middle">CALI &middot; KALESMA &middot; BILL &amp; COO</text>
              </g>
              <g>
                <ellipse cx="745" cy="344" rx="19" ry="15" fill="#F2EFE6" opacity="0.9"/>
                <text x="778" y="341" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6">PAROS</text>
                <text x="778" y="357" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)">PARILIO &middot; COSME</text>
              </g>
              <g>
                <ellipse cx="562" cy="381" rx="16" ry="21" fill="#F2EFE6" opacity="0.9"/>
                <text x="530" y="378" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6" text-anchor="end">SIFNOS</text>
                <text x="530" y="394" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)" text-anchor="end">STAMNA</text>
              </g>
              <g>
                <ellipse cx="647" cy="498" rx="17" ry="9" fill="#F2EFE6" opacity="0.9" transform="rotate(-25 647 498)"/>
                <text x="614" y="516" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6" text-anchor="end">FOLEGANDROS</text>
                <text x="614" y="532" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)" text-anchor="end">GUNDARI</text>
              </g>
              <g>
                <path d="M856,536 C872,530 884,542 886,560 C888,578 878,592 862,594 C852,595 846,588 850,582 C858,584 868,578 870,564 C871,550 864,542 854,544 Z" fill="#F2EFE6" opacity="0.95"/>
                <text x="838" y="546" font-size="14" font-weight="500" letter-spacing="1.5" fill="#F2EFE6" text-anchor="end">SANTORINI</text>
                <text x="838" y="562" font-size="10.5" letter-spacing="1" fill="rgba(242,239,230,0.6)" text-anchor="end">CANAVES &middot; ANDRONIS</text>
              </g>
            </svg>
          </div>
        </div>
      )}

      {s.photo && (
        <figure class="wide-photo reveal">
          <img src={s.photo.src} alt={s.photo.alt} width="2200" height="711" loading="lazy" decoding="async" />
        </figure>
      )}

      {s.circuits.map((c) => (
        <>
          {c.label && <p class="circuit reveal">{c.label}</p>}
          <div class="cards reveal" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); margin-bottom:8px;">
            {c.hotels.map((h) => (
              <a class="card" href={h.href}>
                <img src={h.img} alt="" width="1600" height="1067" loading="lazy" decoding="async" />
                <div class="pad">
                  <span class="kicker">{h.kicker}</span>
                  <h3 set:html={h.name} />
                  {h.award && <span class="award">{h.award}</span>}
                  <p set:html={h.blurb} />
                  <span class="go">Explore &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </>
      ))}

      {s.experiences && (
        <div class="exp reveal">
          <p class="stamp plain" style="font-weight:700; color:var(--brass); margin-bottom:20px;">On the ground</p>
          <div class="exp-grid">
            {s.experiences.map(([b, rest]) => (
              <p class="exp-item"><b set:html={b} /> &mdash; <span set:html={rest} /></p>
            ))}
          </div>
          {s.expCredit && <p class="exp-credit" set:html={s.expCredit} />}
        </div>
      )}
      {!s.experiences && s.expCredit && <p class="exp-credit reveal" style="margin-top:32px;" set:html={s.expCredit} />}

      <div class="cta-band reveal">
        <p class="deck" style="font-size:1.05rem;" set:html={s.cta} />
        <a class="btn" href={s.ctaHref || '#inquire'} data-gtag-label={s.ctaHref ? 'tennis_ranking' : 'start_planning'} data-gtag-location={s.id}>{s.ctaLabel || 'Start planning'}</a>
      </div>
    </div>
  </section>
))}

<!-- beyond the hotels -->
<section class="section" style="padding:64px 0;">
  <div class="container" style="max-width:760px; text-align:center;">
    <span class="eyebrow" style="display:block; margin-bottom:14px;">Beyond the hotels</span>
    <p class="deck" style="margin:0;">Private yacht charters through trusted brokers, private jets for domestic and international travel, and helicopter transfers through my <a href="/hoper.html" style="color:var(--brass);">Hoper partnership</a> &mdash; if the trip calls for it, I&rsquo;ll arrange it.</p>
  </div>
</section>

<!-- ask -->
<section class="section inquire band on-shadow" id="inquire" style="scroll-margin-top:70px;">
  <div class="container">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">One question</span>
    <h2 class="display-l reveal">Where and when?</h2>
    <p class="deck reveal" style="margin:18px auto 0; max-width:38ch;">&ldquo;Kyoto in November&rdquo; is a complete answer. I&rsquo;ll take it from there.</p>
    <form class="inquire-form reveal" action="https://formspree.io/f/mjgnadov" method="POST">
      <input type="hidden" name="_subject" value="Inquiry — Featured Destinations" />
      <input type="hidden" name="page" value="featured-destinations" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="step1">
        <label for="q-when" style="color:var(--band-ash);">Where and when?</label>
        <input id="q-when" type="text" name="travel_dates" placeholder="Kyoto in November" required autocomplete="off" />
      </div>
      <div class="step2">
        <label for="q-name" style="color:var(--band-ash);">And where do I send the recommendation?</label>
        <input id="q-name" type="text" name="name" placeholder="Name" required autocomplete="name" />
        <input id="q-email" type="email" name="email" placeholder="Email" required autocomplete="email" />
        <label for="q-details" style="margin-top:2px; color:var(--band-ash);">Anything else? Nights, budget, occasion &mdash; optional</label>
        <input id="q-details" type="text" name="details" placeholder="7 nights &middot; around $1,500/night &middot; anniversary" autocomplete="off" />
      </div>
      <button type="submit" class="btn">Send</button>
      <p class="note" style="color:var(--band-ash);">Traveling within the next 30 days? You&rsquo;ll hear from me today.</p>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
    <p class="small reveal" style="margin-top:26px; color:var(--band-ash); font-family:var(--display); font-style:italic;">Client itineraries are never published or shared. References available on request.</p>
  </div>
</section>

</Layout>

<style>
  .jump { position: sticky; top: 0; z-index: 25; background: var(--plaster); border-bottom: 1px solid var(--hairline); }
  .jump .container { display: flex; gap: 26px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding-top: 13px; padding-bottom: 13px; }
  .jump .container::-webkit-scrollbar { display: none; }
  .jump a { font-size: .68rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--ash); text-decoration: none; white-space: nowrap; }
  .jump a:hover { color: var(--ink); }

  .adv { display: grid; gap: 28px; grid-template-columns: 1fr; background: var(--lime); border: 1px solid var(--hairline); padding: clamp(28px, 4vw, 44px); }
  @media (min-width: 860px) { .adv { grid-template-columns: repeat(3, 1fr); gap: 36px; } }
  .adv p:last-child { margin-top: 12px; font-size: .92rem; color: var(--ash); line-height: 1.65; }

  .map { background: var(--shadow); padding: clamp(16px, 3vw, 36px); margin-bottom: 40px; }
  .band .map { border: 1px solid var(--band-hairline); }
  .map-scroll { overflow-x: auto; }
  .map svg { display: block; width: 100%; min-width: 620px; height: auto; font-family: var(--body); }

  .wide-photo { margin: 0 0 40px; }
  .wide-photo img { width: 100%; aspect-ratio: 21/9; object-fit: cover; }

  .circuit {
    font-family: var(--stamp); font-size: .7rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--brass);
    border-bottom: 1px solid var(--hairline); padding-bottom: 10px; margin: 34px 0 20px;
  }
  .band .circuit { color: var(--brass-lit); border-bottom-color: var(--band-hairline); }

  .card .award { font-family: var(--stamp); font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--brass); }

  .exp { margin-top: 44px; border-top: 1px solid var(--hairline); padding-top: 30px; }
  .band .exp { border-top-color: var(--band-hairline); }
  .exp-grid { display: grid; gap: 16px 48px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .exp-grid { grid-template-columns: 1fr 1fr; } }
  .exp-item { font-size: .93rem; color: var(--ash); line-height: 1.6; padding-left: 16px; position: relative; }
  .band .exp-item { color: var(--band-ash); }
  .exp-item::before { content: ""; position: absolute; left: 0; top: .62em; width: 4px; height: 4px; background: var(--brass); }
  .band .exp-item::before { background: var(--brass-lit); }
  .exp-item b { color: var(--ink); font-weight: 500; }
  .band .exp-item b { color: var(--band-ink); }
  .exp-item :global(a) { color: var(--brass); }
  .band .exp-item :global(a) { color: var(--brass-lit); }
  .exp-credit { font-family: var(--display); font-style: italic; font-size: .95rem; color: var(--ash); margin-top: 22px; }
  .band .exp-credit { color: var(--band-ash); }
  .exp-credit :global(a) { color: var(--brass); }
  .band .exp-credit :global(a) { color: var(--brass-lit); }

  .cta-band { margin-top: 44px; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; border-left: 2px solid var(--brass); padding-left: clamp(18px, 3vw, 28px); }
  .band .cta-band { border-left-color: var(--brass-lit); }
  .cta-band .deck { max-width: 44ch; }
</style>
