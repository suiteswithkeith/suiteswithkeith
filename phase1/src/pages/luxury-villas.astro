---
import Layout from '../layouts/Layout.astro';

const villas = [
  { href: '/canaves-epitome-villas-santorini.html', img: '/images/hotels/epitome-villas/family-arch-sunset.jpg', kicker: 'Santorini · Stayed', title: 'Canaves Epitome', blurb: 'Five- and three-bedroom pool villas, no age restrictions, and my pick for the best family villa in Santorini.', size: 'Sleeps up to 14' },
  { href: '/andronis-villas-santorini.html', img: '/images/hotels/andronis-villas/concept-three-bedroom-pool.jpg', kicker: 'Santorini · Toured', title: 'Andronis Villas', blurb: 'Thirteen private pool villas across four hotels in Oia and Imerovigli, up to the twelve-guest Eden Villa.', size: 'Sleeps 2 to 12' },
  { href: '/fouquets-mykonos-villas.html', img: '/images/hotels/fouquets-delos-villa-pool.jpg', kicker: 'Mykonos · Toured', title: 'Fouquet&rsquo;s Mykonos', blurb: 'Four villas on the south coast, from an intimate two-bedroom to seven-bedroom Paradiso and Delos.', size: 'Sleeps 4 to 14' },
  { href: '/four-seasons-mykonos-villas.html', img: '/images/hotels/four-seasons-mykonos-syros-infinity-pool.jpg', kicker: 'Mykonos · Vetted', title: 'Four Seasons Mykonos', blurb: 'Two private pool villas above a private beach, with a Four Seasons kids club behind them.', size: 'Sleeps 4 to 6' },
  { href: '/best-villa-paros-jupiter.html', img: '/images/hotels/jupiter-villa-pool.jpg', kicker: 'Paros · Toured', title: 'Par&#299;lio: Jupiter &amp; Aurelia', blurb: 'My Best Paros Villa, five king bedrooms and a private pool, plus the three-bedroom Aurelia next door.', size: '3 to 5 bedrooms' },
  { href: '/gundari-villas-folegandros.html', img: '/images/hotels/gundari-three-bedroom-villa-terrace-pergola.jpg', kicker: 'Folegandros · Visited', title: 'Gundari', blurb: 'Two cliff-front villas with 60 m&sup2; private pools, on the island that filters its own crowd.', size: 'Sleeps 8 to 10' },
  { href: '/borgo-pignano-villas-tuscany.html', img: '/images/tuscany/borgo-pignano-pool-wide.jpg', kicker: 'Tuscany · Stayed', title: 'Borgo Pignano', blurb: 'Around nine private villas on a hilltop estate outside Volterra, with a kids&rsquo; pool, tennis and a spa.', size: '2 to 5 bedrooms' },
  { href: '/hotels/airelles-palladio-venice-suite-del-doge.html', img: '/images/hotels/airelles-palladio-venice/press-doge-salon-salute.jpg', kicker: 'Venice · Toured', title: 'Airelles Palladio: Suite del Doge', blurb: 'A frescoed four-bedroom penthouse on Giudecca, with the Salute framed across the water, at my number one hotel in Italy.', size: 'Sleeps 8, villa buyout to 13 bedrooms' },
  { href: '/forestis-villa-dolomites.html', img: '/images/dolomites/forestis/tower-suite-view.jpg', kicker: 'The Dolomites · Stayed', title: 'Forestis Villa', blurb: 'Five bedrooms, a team of 14, a private pool and spa, and children welcome at an adults-only hotel.', size: 'Sleeps 10' },
  { href: '/four-seasons-napa-valley-villas-residences.html', img: '/images/napa/four-seasons-1.jpg', kicker: 'Napa Valley · Stayed', title: 'Four Seasons Napa Valley', blurb: 'Villas and residences on a working vineyard in Calistoga, for families and groups of friends.', size: 'Families &amp; groups' },
];

const faq = [
  ['How do you choose the villas on this page?', 'Every villa here sits at a hotel I&rsquo;ve stayed at, toured or work with closely, and I&rsquo;ve sent clients to them. If I wouldn&rsquo;t book it for my own family, it isn&rsquo;t here.'],
  ['Why villas at hotels instead of private villa rentals?', 'I&rsquo;m very pro private villas at hotels versus standalone villas. You get your own house and your own pool, with a full hotel team, restaurants, a spa and often a kids club behind you, instead of arranging staff and groceries yourself.'],
  ['What&rsquo;s the best villa for a family?', 'For Santorini, the Canaves Epitome villas. For Mykonos, Four Seasons for younger kids and Fouquet&rsquo;s for bigger groups. In Italy, Borgo Pignano in Tuscany. Tell me the kids&rsquo; ages and I&rsquo;ll narrow it down.'],
  ['Does booking a villa through you cost more?', 'No. Rates are identical to booking direct, and my clients receive Fora perks on eligible stays.'],
];
---
<Layout
  canonical="luxury-villas.html"
  title="Luxury Villas & Penthouses, Hand-Selected by Suites With Keith | Greece, Italy & Napa"
  description="Private villas and penthouses at the best hotels in Santorini, Mykonos, Paros, Folegandros, Venice, Tuscany, the Dolomites and Napa Valley, every one personally toured or vetted by Keith. Villas for families, groups and celebrations, with a hotel's service behind them."
  preload="/images/hotels/fouquets-delos-villa-pool.jpg"
  current="guides"
  ctaLabel="Ask about a villa"
>

<script type="application/ld+json" slot="head" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/&rsquo;/g, '’'), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '').replace(/&rsquo;/g, '’') } })),
})} />

<header class="hero" style="min-height:min(72svh,680px);">
  <img class="hero-img" src="/images/hotels/fouquets-delos-villa-pool.jpg" alt="A long private villa pool suspended over the sea at dusk, Mykonos" width="1800" height="1230" fetchpriority="high" />
  <div class="container">
    <p class="eyebrow">Greece &middot; Italy &middot; Napa Valley</p>
    <h1 class="display-xl" style="margin-top:18px;">Luxury Villas, Hand-Selected</h1>
    <p class="sub">Private villas at the hotels I know best, every one personally toured or vetted, for families, groups and the trips that deserve a whole house.</p>
    <div class="hero-ctas">
      <a class="btn" href="#inquire" data-gtag-label="start_planning" data-gtag-location="hero">Ask about a villa</a>
    </div>
  </div>
</header>

<section class="section">
  <div class="container" style="max-width:860px;">
    <div class="reveal">
      <p class="deck" style="max-width:46ch;">These are the villas I book for my own clients: at hotels I&rsquo;ve stayed at or toured, with teams I know and trust.</p>
      <p class="body-2" style="margin-top:20px; max-width:62ch;">I&rsquo;m very pro private villas at hotels versus standalone villas. You get your own house and your own pool, with real service behind it: the hotel&rsquo;s restaurants, its spa, often a kids club, and a team that knows your name. No sourcing a chef, no stocking the fridge, and one person to call if anything isn&rsquo;t right.</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="cards three">
      {villas.map((v) => (
        <a class="card reveal" href={v.href}>
          <img src={v.img} alt="" width="1600" height="1200" loading="lazy" decoding="async" />
          <div class="pad"><span class="kicker" set:html={v.kicker} /><h3 set:html={v.title} /><p set:html={v.blurb} /><span class="size" set:html={v.size} /><span class="go">See the villas &rarr;</span></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section band on-shadow">
  <div class="container" style="max-width:860px;">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">How I&rsquo;d choose</span>
    <h2 class="display-l reveal">Which villa, for which trip</h2>
    <ul class="why reveal">
      <li><b>Young kids:</b> <a href="/canaves-epitome-villas-santorini.html">Canaves Epitome</a> on Santorini, or <a href="/four-seasons-mykonos-villas.html">Four Seasons Mykonos</a> with its kids club and private beach.</li>
      <li><b>Two or three families together:</b> <a href="/fouquets-mykonos-villas.html">Fouquet&rsquo;s Paradiso or Delos</a>, <a href="/andronis-villas-santorini.html">the Andronis Eden Villa</a>, or <a href="/best-villa-paros-jupiter.html">Jupiter</a> on Paros.</li>
      <li><b>A milestone celebration:</b> <a href="/hotels/airelles-palladio-venice-suite-del-doge.html">the Suite del Doge</a> at Airelles Palladio in Venice, <a href="/forestis-villa-dolomites.html">the Forestis Villa</a> in the Dolomites, or <a href="/gundari-villas-folegandros.html">Gundari</a> on the cliffs of Folegandros.</li>
      <li><b>A slow Italian summer:</b> <a href="/borgo-pignano-villas-tuscany.html">Borgo Pignano</a> in Tuscany.</li>
      <li><b>Wine country with friends:</b> <a href="/four-seasons-napa-valley-villas-residences.html">Four Seasons Napa Valley</a> in Calistoga.</li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:820px;">
    <div class="sec-head reveal">
      <span class="eyebrow">Before you ask</span>
      <h2 class="display-l">The questions I get</h2>
    </div>
    <div class="faq reveal">
      {faq.map(([q, a]) => (
        <details>
          <summary set:html={q} />
          <p class="body-2" set:html={a} />
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section inquire band on-shadow" id="inquire" style="scroll-margin-top:70px;">
  <div class="container">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">Luxury villas</span>
    <h2 class="display-l reveal">When are you thinking?</h2>
    <p class="deck reveal" style="margin:18px auto 0; max-width:44ch;">Tell me your dates, who&rsquo;s coming and where you&rsquo;re dreaming of. I&rsquo;ll come back with the right villa and plan the trip around it.</p>
    <form class="inquire-form reveal" action="https://formspree.io/f/mjgnadov" method="POST">
      <input type="hidden" name="_subject" value="Villa inquiry (villas hub)" />
      <input type="hidden" name="hotel" value="Luxury villas hub" />
      <input type="hidden" name="page" value="luxury-villas" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="step1">
        <label for="q-when" style="color:var(--band-ash);">When are you thinking?</label>
        <input id="q-when" type="text" name="travel_dates" placeholder="July 2027 · 6 nights · 10 guests" required autocomplete="off" />
      </div>
      <div class="step2">
        <label for="q-name" style="color:var(--band-ash);">And where do I send the plan?</label>
        <input id="q-name" type="text" name="name" placeholder="Name" required autocomplete="name" />
        <input id="q-email" type="email" name="email" placeholder="Email" required autocomplete="email" />
        <label for="q-details" style="margin-top:2px; color:var(--band-ash);">Anything else? Where, kids&rsquo; ages, occasion (optional)</label>
        <input id="q-details" type="text" name="details" placeholder="Greece or Italy · kids 6 and 9 · 50th birthday" autocomplete="off" />
      </div>
      <button type="submit" class="btn" data-gtag-label="villa_inquiry_send" data-gtag-location="villa_cta">Send</button>
      <p class="note" style="color:var(--band-ash);">Traveling within the next 30 days? You&rsquo;ll hear from me today.</p>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

</Layout>

<style>
  .cards.three { max-width: 1040px; margin: 0 auto; }
  .cards.three .card img { aspect-ratio: 16/10; }
  .card .size { font-size: .85rem; color: var(--ash); }
  .why { margin-top: 24px; padding-left: 1.1em; max-width: 62ch; }
  .why li { margin-top: 12px; line-height: 1.6; }
  .why a { color: inherit; }
  .faq details { border-top: 1px solid var(--hairline); padding: 18px 0; }
  .faq details:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { cursor: pointer; font-family: var(--display); font-size: 1.2rem; list-style: none; position: relative; padding-right: 28px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; position: absolute; right: 0; top: 0; color: var(--brass); font-family: var(--body); }
  .faq details[open] summary::after { content: "\2013"; }
  .faq details p { margin-top: 12px; max-width: 62ch; }
</style>
