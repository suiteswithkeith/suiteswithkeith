---
import Layout from '../layouts/Layout.astro';

const partners = [
  ['aman.png', 'Aman', 'tint'], ['belmond.png', 'Belmond', ''], ['bulgari.png', 'Bulgari Hotels & Resorts', ''],
  ['dorchester.png', 'Dorchester Collection', ''], ['four-seasons.png', 'Four Seasons Hotels & Resorts', ''],
  ['oetker.png', 'Oetker Collection', ''], ['ritz-carlton.png', 'The Ritz-Carlton', ''],
  ['rosewood.png', 'Rosewood Hotels & Resorts', 'tint'], ['st-regis.png', 'St. Regis Hotels & Resorts', ''],
  ['waldorf-astoria.png', 'Waldorf Astoria Hotels & Resorts', 'tint'], ['montage.svg', 'Montage Hotels & Resorts', ''],
  ['auberge.png', 'Auberge Resorts Collection', ''], ['one-and-only.svg', 'One&Only Resorts', ''],
  ['capella.svg', 'Capella Hotels & Resorts', 'inv'], ['mandarin-oriental.svg', 'Mandarin Oriental Hotel Group', ''],
  ['six-senses.svg', 'Six Senses Hotels Resorts Spas', ''], ['peninsula.png', 'The Peninsula Hotels', 'tint'],
  ['langham.png', 'Langham Hospitality Group', 'tint'], ['rocco-forte.svg', 'Rocco Forte Hotels', ''],
  ['relais-chateaux.png', 'Relais & Châteaux', ''], ['lhw.svg', 'The Leading Hotels of the World', ''],
];
---
<Layout
  canonical="corporate-travel.html"
  title="Corporate Travel | Suites With Keith"
  description="Executive travel, incentive trips, and team offsites — planned by one advisor with the hotel relationships behind every Suites With Keith trip."
>

<!-- masthead -->
<section class="section" style="padding-bottom:0;">
  <div class="container">
    <p class="eyebrow reveal">What we do</p>
    <h1 class="display-xl reveal" style="margin-top:18px;">Corporate travel</h1>
    <p class="deck reveal" style="margin-top:22px; max-width:46ch;">Travel planning for companies that want it handled &mdash; simply, personally, and at a level their people notice.</p>
    <p class="body-2 reveal" style="margin-top:22px; max-width:58ch;">From managing itineraries for time-pressed executives to designing incentive retreats your top performers will talk about for years, I act as an extension of your team. The relationships behind every Suites With Keith honeymoon &mdash; luxury hotels, private villas, and preferred partners worldwide &mdash; now working for your leadership offsite, your incentive trip, your next executive itinerary.</p>
    <p class="reveal" style="margin-top:26px;"><a class="btn" href="#inquire" data-gtag-label="start_planning" data-gtag-location="corp_masthead">Start a conversation</a></p>
  </div>
</section>

<!-- photo -->
<section class="section" style="padding-bottom:0;">
  <div class="container">
    <figure class="reveal" style="margin:0;">
      <img src="/images/personal/montage-cabo.jpg" alt="Oceanfront resort pool at Montage Los Cabos" width="1800" height="1200" loading="lazy" decoding="async" style="width:100%; aspect-ratio:21/9; object-fit:cover;" />
    </figure>
  </div>
</section>

<!-- services -->
<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">The offering</span>
      <h2 class="display-l">The same approach, built for business</h2>
    </div>
    <div class="corp-grid reveal">
      <div class="corp-tile">
        <span class="stamp plain" style="font-weight:700; color:var(--brass);">Custom pricing</span>
        <h3>Executive &amp; business travel</h3>
        <p>White-glove planning for executives and leadership &mdash; flights, hotels, and ground transport handled with discretion, precision, and a single point of contact for every trip.</p>
      </div>
      <div class="corp-tile">
        <span class="stamp plain" style="font-weight:700; color:var(--brass);">Custom pricing</span>
        <h3>Incentive trips &amp; retreats</h3>
        <p>Reward top performers or bring leadership together somewhere worth the flight. I design and manage incentive trips and offsites end-to-end, from destination selection to on-the-ground logistics.</p>
      </div>
      <div class="corp-tile">
        <span class="stamp plain" style="font-weight:700; color:var(--brass);">Custom pricing</span>
        <h3>Group &amp; team logistics</h3>
        <p>Coordinating travel for a full team or department &mdash; conferences, offsites, and multi-traveler logistics &mdash; so nothing falls through the cracks and everyone arrives ready.</p>
      </div>
    </div>
  </div>
</section>

<!-- why -->
<section class="section band on-shadow">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Why companies work with Keith</span>
      <h2 class="display-l">The same standard, applied to business travel</h2>
    </div>
    <div class="ledger reveal">
      <div class="ledger-row"><span class="n">01</span><span class="d"><b>One point of contact.</b> No juggling vendors or booking sites &mdash; one advisor handles hotels, transport, and logistics from first inquiry to the trip itself.</span></div>
      <div class="ledger-row"><span class="n">02</span><span class="d"><b>Preferred partner access.</b> The same Virtuoso and Fora hotel relationships behind every Suites With Keith trip &mdash; often meaning upgrades, amenities, and priority handling for your group.</span></div>
      <div class="ledger-row"><span class="n">03</span><span class="d"><b>Discretion &amp; reliability.</b> Executive and incentive travel planned with the same care and confidentiality as high-profile personal trips &mdash; and a plan for when things change last-minute.</span></div>
    </div>
  </div>
</section>

<!-- where I send companies -->
<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Where I send companies</span>
      <h2 class="display-l">Properties I&rsquo;d send a group to tomorrow</h2>
      <p class="deck" style="margin-top:16px; max-width:48ch;">A short list I&rsquo;ve personally worked with.</p>
    </div>
    <div class="cards reveal" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr));">
      <div class="card">
        <img src="/images/personal/montage-cabo.jpg" alt="" width="1600" height="1200" loading="lazy" decoding="async" />
        <div class="pad"><span class="kicker">Los Cabos</span><h3>Montage Los Cabos</h3><p>Cabo&rsquo;s biggest, most complete resort &mdash; multiple restaurants, a full spa, and enough space to host a large incentive group without anyone feeling on top of each other.</p></div>
      </div>
      <div class="card">
        <img src="/images/hotels/chileno-bay-1.jpg" alt="" width="1600" height="1200" loading="lazy" decoding="async" />
        <div class="pad"><span class="kicker">Los Cabos</span><h3>Chileno Bay, Auberge Resorts</h3><p>Quieter and more residential than the resort strip, on one of the only swimmable beaches in Cabo &mdash; a strong fit for smaller leadership groups.</p></div>
      </div>
      <div class="card">
        <img src="/images/hotels/oneandonly-palmilla-1.jpg" alt="" width="1600" height="1200" loading="lazy" decoding="async" />
        <div class="pad"><span class="kicker">Los Cabos</span><h3>One&amp;Only Palmilla</h3><p>The original Cabo icon. Still delivers for a milestone incentive trip or a full-property buyout.</p></div>
      </div>
      <div class="card">
        <img src="/images/napa/montage-1.jpg" alt="" width="1600" height="1200" loading="lazy" decoding="async" />
        <div class="pad"><span class="kicker">Sonoma</span><h3>Montage Healdsburg</h3><p>Wine country instead of the coast. I&rsquo;ve worked directly with the team here &mdash; one of my top picks when the goal is a retreat, not a beach party.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- partners -->
<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="sec-head reveal" style="margin-bottom:10px;">
      <span class="eyebrow">Preferred partners</span>
      <h2 class="display-m" style="margin-top:14px;">The hotel groups I book with partner benefits</h2>
      <p class="body-2 small" style="margin-top:10px; max-width:56ch;">Typically room upgrades, resort credits, and VIP treatment for your travelers.</p>
    </div>
  </div>
  <div class="marquee reveal" aria-label="Preferred hotel partners">
    <div class="track">
      <div class="set">
        {partners.map(([f, alt, cls]) => (
          <span class={`plogo ${cls}`}><img src={`/images/logos/partners/${f}`} alt={alt} loading="lazy" decoding="async" /></span>
        ))}
      </div>
      <div class="set" aria-hidden="true">
        {partners.map(([f, , cls]) => (
          <span class={`plogo ${cls}`}><img src={`/images/logos/partners/${f}`} alt="" loading="lazy" decoding="async" /></span>
        ))}
      </div>
    </div>
  </div>
  <div class="container" style="text-align:center; margin-top:44px;">
    <p class="stamp plain reveal" style="font-weight:700; color:var(--ash-3); margin-bottom:20px;">Many of the properties I book hold the industry&rsquo;s highest independent honors</p>
    <div class="reveal" style="display:flex; justify-content:center; align-items:center; gap:48px;">
      <img src="/images/logos/partners/forbes-five-star.png" alt="Forbes Travel Guide Five-Star Rating" width="500" height="541" loading="lazy" decoding="async" style="max-height:72px; width:auto; filter:grayscale(1); opacity:.8;" />
      <img src="/images/logos/partners/michelin.png" alt="MICHELIN Guide" width="500" height="561" loading="lazy" decoding="async" style="max-height:72px; width:auto; filter:grayscale(1); opacity:.8;" />
    </div>
  </div>
</section>

<!-- ask -->
<section class="section inquire band on-shadow" id="inquire" style="scroll-margin-top:70px;">
  <div class="container">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">Tell me about your trip</span>
    <h2 class="display-l reveal">Share a few details and I&rsquo;ll follow up</h2>
    <p class="deck reveal" style="margin:18px auto 0; max-width:42ch;">Within a couple of business days &mdash; usually sooner.</p>
    <form class="inquire-form reveal" action="https://formspree.io/f/mjgnadov" method="POST" style="max-width:520px;">
      <input type="hidden" name="_subject" value="New corporate travel inquiry from Suites With Keith" />
      <input type="hidden" name="page" value="corporate-travel" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <label for="cf-name" style="color:var(--band-ash);">Name</label>
      <input id="cf-name" type="text" name="name" required autocomplete="name" />
      <label for="cf-company" style="color:var(--band-ash);">Company</label>
      <input id="cf-company" type="text" name="company" required autocomplete="organization" />
      <label for="cf-email" style="color:var(--band-ash);">Email</label>
      <input id="cf-email" type="email" name="email" required autocomplete="email" />
      <label for="cf-dates" style="color:var(--band-ash);">Target dates &amp; group size</label>
      <input id="cf-dates" type="text" name="travel_dates" placeholder="Q3 2027 &middot; 25 people" autocomplete="off" />
      <label for="cf-details" style="color:var(--band-ash);">Trip type, budget, anything else &mdash; optional</label>
      <input id="cf-details" type="text" name="details" placeholder="Incentive trip &middot; around $500/person/night" autocomplete="off" />
      <button type="submit" class="btn">Send</button>
      <p class="note" style="color:var(--band-ash);">Or email keith.pence@fora.travel directly.</p>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

</Layout>

<style>
  .corp-grid { display: grid; gap: 22px; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .corp-grid { grid-template-columns: repeat(3, 1fr); } }
  .corp-tile { background: var(--lime); border: 1px solid var(--hairline); padding: clamp(24px, 3vw, 32px); }
  .corp-tile h3 { font-family: var(--display); font-weight: 500; font-size: 1.35rem; margin: 12px 0 10px; }
  .corp-tile p { font-size: .95rem; color: var(--ash); line-height: 1.65; }

  .marquee { position: relative; overflow: hidden; margin-top: 26px; }
  .marquee::before, .marquee::after { content: ""; position: absolute; top: 0; bottom: 0; width: 90px; z-index: 1; pointer-events: none; }
  .marquee::before { left: 0; background: linear-gradient(to right, var(--plaster), transparent); }
  .marquee::after { right: 0; background: linear-gradient(to left, var(--plaster), transparent); }
  .track { display: flex; align-items: center; gap: 84px; width: max-content; padding: 14px 0; animation: partner-scroll 55s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .set { display: flex; align-items: center; gap: 84px; flex: 0 0 auto; }
  .plogo { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
  .plogo img { height: 50px; max-width: 165px; width: auto; object-fit: contain; filter: grayscale(1); opacity: .7; mix-blend-mode: multiply; }
  .plogo.tint img { filter: grayscale(1) brightness(1.14) contrast(1.08); }
  .plogo.inv img { filter: invert(1) grayscale(1); }
  @keyframes partner-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; gap: 40px; }
    .set:last-child { display: none; }
  }
</style>
