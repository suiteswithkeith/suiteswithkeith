---
import Layout from '../layouts/Layout.astro';
import Ask from '../components/Ask.astro';

const regions = [
  { label: 'Greece', items: [
    ['01', 'Canaves Oia Epitome', 'Santorini · the modern caldera icon', '/hotels/canaves-epitome-santorini.html'],
    ['02', 'Kalesma', 'Mykonos · design-led and unexpectedly calm', '/hotels/kalesma-mykonos.html'],
    ['03', 'Gundari', 'Folegandros · for couples who want no crowds', '/hotels/gundari-folegandros.html'],
    ['04', 'Par&#299;lio', 'Paros · relaxed luxury, easy to love', '/hotels/parilio-paros.html'],
  ]},
  { label: 'Italy', items: [
    ['05', 'Passalacqua', 'Lake Como · a villa you never want to leave', '/hotels/passalacqua-lake-como.html'],
    ['06', 'Il San Pietro di Positano', 'Amalfi Coast · the classic, done properly', '/hotels/il-san-pietro-di-positano.html'],
    ['07', 'Borgo Egnazia', 'Puglia · space, food, and privacy', '/hotels/borgo-egnazia-puglia.html'],
    ['08', 'Grand Hotel Timeo', 'Taormina · Etna views and old-world service', '/hotels/grand-hotel-timeo-taormina.html'],
  ]},
  { label: 'The Maldives', items: [
    ['09', 'Soneva Jani', 'Overwater villas with retractable roofs', '/hotels/soneva-jani-maldives.html'],
    ['10', 'Joali Being', 'Wellness-first, for a restorative honeymoon', '/hotels/joali-being-maldives.html'],
    ['11', 'Cheval Blanc Randheli', 'The most polished service in the atolls', '/hotels/cheval-blanc-randheli-maldives.html'],
  ]},
  { label: 'Hawaii', items: [
    ['12', 'Four Seasons Hualalai', 'Big Island · the benchmark for service', '/hotels/four-seasons-hualalai-hawaii.html'],
    ['13', 'Four Seasons Resort Lanai', 'Lanai · remote, private, unmatched for couples', '/hotels/four-seasons-lanai-hawaii.html'],
  ]},
  { label: 'Napa & Sonoma', items: [
    ['14', 'Auberge du Soleil', 'Napa · the terrace, the valley, the wine list', '/hotels/auberge-du-soleil-napa.html'],
    ['15', 'Montage Healdsburg', 'Sonoma · vineyard bungalows, slower pace', '/hotels/montage-healdsburg.html'],
  ]},
];
const left = regions.slice(0, 2);
const right = regions.slice(2);
---
<Layout
  canonical="the-fifteen.html"
  title="The Fifteen — Honeymoon Hotels I'd Book Anywhere | Suites With Keith"
  description="Not a ranking — a shortlist. Fifteen honeymoon hotels I'd book anywhere in the world, each visited or booked repeatedly, each right for a different kind of couple."
  current="rankings"
>

<!-- masthead -->
<section class="section band on-shadow" style="text-align:center; padding:clamp(70px,10vw,110px) 0;">
  <div class="container">
    <span class="eyebrow">Keith&rsquo;s list &middot; 2026</span>
    <h1 class="display-xl" style="margin:18px auto 14px;">The Fifteen</h1>
    <p class="deck" style="margin:0 auto; max-width:40ch;">Honeymoon hotels I&rsquo;d book anywhere in the world.</p>
    <p class="body-2" style="margin:22px auto 0; max-width:54ch;">Not a ranking &mdash; a shortlist. Every property here I&rsquo;ve either visited or booked repeatedly, and each one earns its place for a different kind of couple.</p>
  </div>
</section>

<!-- the list -->
<section class="section">
  <div class="container tf-cols" style="max-width:980px;">
    {[left, right].map((col) => (
      <div>
        {col.map((r) => (
          <div class="tf-region reveal">
            <p class="stamp plain" style="font-weight:700; color:var(--brass); border-bottom:1px solid var(--hairline); padding-bottom:10px; margin-bottom:4px; display:block;" set:html={r.label} />
            {r.items.map(([num, name, sub, href]) => (
              <a class="tf-item" href={href}>
                <span class="tf-num">{num}</span>
                <span>
                  <b set:html={name} />
                  <em set:html={sub} />
                </span>
                <span class="tf-go" aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
        ))}
        {col === right && (
          <div class="tf-callout reveal">
            <p class="stamp plain" style="font-weight:700; color:var(--brass); margin-bottom:8px;">How to use this list</p>
            <p>Pick two or three that appeal and tell me why. The reasons behind the choice tell me far more than the list itself &mdash; and usually point to a fourth property you haven&rsquo;t heard of.</p>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<Ask
  subject="Inquiry — The Fifteen"
  page="the-fifteen"
  placeholder="Honeymoon, next June"
  deck="Tell me the trip you&rsquo;re imagining and I&rsquo;ll tell you which of these fits."
  dark
/>

</Layout>

<style>
  .tf-cols { display: grid; gap: 0 64px; grid-template-columns: 1fr; }
  @media (min-width: 820px) { .tf-cols { grid-template-columns: 1fr 1fr; } }
  .tf-region { margin-bottom: 40px; }
  .tf-item {
    display: grid; grid-template-columns: 34px 1fr auto; gap: 14px; align-items: baseline;
    padding: 16px 0; border-bottom: 1px solid var(--hairline); text-decoration: none;
  }
  .tf-num { font-family: var(--stamp); font-size: .72rem; color: var(--ash-3); }
  .tf-item b { display: block; font-family: var(--display); font-weight: 500; font-size: 1.12rem; color: var(--ink); }
  .tf-item em { display: block; font-style: normal; font-size: .88rem; color: var(--ash); margin-top: 3px; }
  .tf-go { color: var(--brass); font-size: .9rem; opacity: 0; transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease); }
  @media (hover:hover) { .tf-item:hover .tf-go { opacity: 1; } .tf-item:hover b { color: var(--brass); } }
  .tf-callout { background: var(--lime); border-left: 2px solid var(--brass); padding: 22px 24px; margin-top: 8px; }
  .tf-callout p:last-child { font-size: .95rem; color: var(--ash); line-height: 1.65; }
</style>
