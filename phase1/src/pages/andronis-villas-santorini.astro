---
import Layout from '../layouts/Layout.astro';

const hotels = [
  {
    name: 'Andronis Arcadia',
    href: '/hotels/andronis-arcadia-santorini.html',
    where: 'Just outside Oia, next door to Canaves Epitome',
    take: 'The only true resort in the portfolio, and the one I&rsquo;d pick for families: every room has a private pool, the ARCADemy kids club and the Evexia Spa give parents and kids somewhere to be at the same time, and the villas face the sunset. Know that Pacman and Beefbar bring a bit of a scene.',
    villas: [
      ['Eden Villa with Infinity Pool', 'Up to 12', '600 m&sup2; / 6,458 sq ft', 'Three storeys in a secluded corner, facing the sunset'],
      ['Four Bedroom Villa with Infinity Pool', 'Up to 8', '220 m&sup2; / 2,368 sq ft', 'Sunset view'],
      ['Three Bedroom Villa with Infinity Pool', 'Up to 6', '200 m&sup2; / 2,152 sq ft', 'Two storeys, every bedroom en suite, sunset view'],
    ],
  },
  {
    name: 'Andronis Concept',
    href: '/hotels/andronis-concept-santorini.html',
    where: 'Near Imerovigli',
    take: 'Warm, earthy modern architecture, the Kallos Spa (the nicest spa I saw on Santorini, and maybe in the Cyclades), and very private rooms. The widest range of villas in the group, and built for longer stays.',
    villas: [
      ['Three Bedroom Villa with Infinity Pool', 'Up to 8', '180 m&sup2; / 1,937 sq ft', 'Caldera and sunset view, a modern kitchen and two private pools'],
      ['Three Bedroom Villa with Garden View and Private Pool', 'Up to 7', '120 m&sup2; / 1,291 sq ft', 'Garden view'],
      ['Four Bedroom Villa with Infinity Pool', 'Up to 6', '120 m&sup2; / 1,291 sq ft', 'Caldera and sunset view'],
      ['Executive Villa with Infinity Pool', 'Up to 4', '80 m&sup2; / 861 sq ft', 'Caldera and sunset view'],
      ['Two Bedroom Villa with Garden View and Private Pool', 'Up to 4', '70 m&sup2; / 753 sq ft', 'Garden view'],
    ],
  },
  {
    name: 'Andronis Luxury Suites',
    href: '/hotels/andronis-luxury-suites-santorini.html',
    where: 'On the caldera in Oia',
    take: 'The refined flagship, home of Lycabettus, the island&rsquo;s most famous cliffside restaurant. Every room has a water feature, it&rsquo;s my pick when mobility is a factor, and the Sunset Villas are made for anniversary trips.',
    villas: [
      ['Two Bedroom Villa with Private Pool', 'Up to 4', '120 m&sup2; / 1,291 sq ft', 'Brand new, volcano view'],
      ['Sunset Villa Aristotelis with Infinity Pool', 'Up to 2', '60 m&sup2; / 645 sq ft', 'Volcano and caldera view'],
      ['Sunset Villa Socrates with Infinity Pool', 'Up to 2', '60 m&sup2; / 645 sq ft', 'Volcano and caldera view'],
      ['White House with Private Pool', 'Up to 2', '50 m&sup2; / 538 sq ft', 'An iconic villa with caldera views'],
    ],
  },
  {
    name: 'Andronis Boutique Hotel',
    href: '/hotels/andronis-boutique-santorini.html',
    where: 'In the center of Oia',
    take: 'Authentic cave-style luxury, and the rooms first-time Santorini visitors are dreaming about. It skews a little younger than the flagship, and rates tend to land slightly below it.',
    villas: [
      ['Two Bedroom Villa with Private Pool and Hot Tub', 'Up to 4', '80 m&sup2; / 861 sq ft', 'Volcano and caldera view'],
    ],
  },
];

const faq = [
  ['What is the largest villa at Andronis?', 'The Eden Villa at Andronis Arcadia: three storeys, 600 square meters (6,458 sq ft), an infinity pool and room for up to 12 guests, in a secluded corner of the resort facing the sunset.'],
  ['Which Andronis villa is best for families?', 'I&rsquo;d start at Andronis Arcadia. Every room has a private pool, there&rsquo;s a real kids club, and the Eden Villa (up to 12), Four Bedroom Villa (up to 8) and Three Bedroom Villa (up to 6) cover most family sizes. At Concept, the Three Bedroom Villa with Garden View sleeps up to 7.'],
  ['Which Andronis villas have caldera views?', 'The villas at Andronis Luxury Suites and Andronis Boutique in Oia sit on the caldera, and most of the Concept villas face the caldera and the sunset. The Arcadia villas face the sunset over the open sea.'],
  ['Do all the Andronis villas have private pools?', 'Yes. Every villa in the collection comes with a private pool, an infinity pool, or a pool and hot tub.'],
  ['Which Andronis villa is best for a honeymoon or anniversary?', 'The Sunset Villas, Aristotelis and Socrates, at Andronis Luxury Suites: infinity pools, caldera views and Lycabettus a few steps away. White House is the other one I&rsquo;d look at for two.'],
  ['How much do the Andronis villas cost?', 'Rates depend on the villa, the season and the length of stay, so ask me for your dates and group size and I&rsquo;ll come back with the right options across all four hotels.'],
  ['What do I get booking through you?', 'I have a preferred partnership with Andronis, so my clients receive Fora perks on eligible stays, like daily breakfast, a space-available upgrade and a hotel credit, and rates are identical to booking direct.'],
];
---
<Layout
  canonical="andronis-villas-santorini.html"
  title="Andronis Villas in Santorini: Private Pool Villas in Oia & Imerovigli | Suites With Keith"
  description="Keith's firsthand guide to the private pool villas at Andronis Arcadia, Concept, Luxury Suites and Boutique in Santorini: thirteen villas from two to twelve guests, including the 600 m² Eden Villa, with caldera and sunset views."
  preload="/images/hotels/andronis-villas/concept-three-bedroom-pool.jpg"
  ctaLabel="Ask about the villas"
>

<script type="application/ld+json" slot="head" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/&rsquo;/g, '’'), acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '').replace(/&rsquo;/g, '’') } })),
})} />

<header class="hero" style="min-height:min(78svh,720px);">
  <img class="hero-img" src="/images/hotels/andronis-villas/concept-three-bedroom-pool.jpg" alt="A private infinity pool facing the caldera at an Andronis Concept villa in Santorini" width="1800" height="1013" fetchpriority="high" />
  <div class="container">
    <p class="eyebrow">Santorini &middot; Toured every Andronis hotel</p>
    <h1 class="display-xl" style="margin-top:18px;">The Andronis Villas</h1>
    <p class="sub">Thirteen private pool villas across four Andronis hotels in Oia and Imerovigli, from caldera hideaways for two to the twelve-guest Eden Villa.</p>
    <div class="hero-ctas">
      <a class="btn" href="#inquire" data-gtag-label="start_planning" data-gtag-location="hero">Ask about the villas</a>
      <a class="btn btn-ghost on-shadow" href="/canaves-vs-andronis.html" style="border-color:rgba(242,239,230,.4); color:var(--band-ink);">Canaves vs. Andronis</a>
    </div>
  </div>
</header>

<section class="section">
  <div class="container" style="max-width:860px;">
    <div class="reveal">
      <p class="deck" style="max-width:44ch;">I&rsquo;ve toured every Andronis hotel on Santorini, and each one does villas a little differently.</p>
      <p class="body-2" style="margin-top:20px; max-width:62ch;">Every Andronis villa comes with its own pool, and the four hotels cover very different trips. Arcadia is the resort, with the biggest villas and real family infrastructure. Concept is the wellness retreat near Imerovigli, with the widest range of villas and the best spa on the island. Luxury Suites and Boutique are the classic Oia caldera addresses, where the villas are made for couples and small families.</p>
      <p class="body-2" style="margin-top:14px; max-width:62ch;">Tell me who&rsquo;s coming and what kind of trip you want, and I&rsquo;ll tell you which hotel, and which villa, fits.</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="photos reveal">
      <figure><img src="/images/hotels/andronis-villas/arcadia-three-bedroom-pool.jpg" alt="Loungers beside the infinity pool of a three-bedroom villa at Andronis Arcadia, Santorini" width="1799" height="1349" loading="lazy" decoding="async" /><figcaption>Three Bedroom Villa, Andronis Arcadia</figcaption></figure>
      <figure><img src="/images/hotels/andronis-villas/luxury-suites-aristotelis-pool.jpg" alt="An infinity pool overlooking the caldera at Sunset Villa Aristotelis, Andronis Luxury Suites, Oia" width="1800" height="1350" loading="lazy" decoding="async" /><figcaption>Sunset Villa Aristotelis, Andronis Luxury Suites</figcaption></figure>
    </div>
  </div>
</section>

{hotels.map((h) => (
  <section class="section" style="padding-top:0;">
    <div class="container" style="max-width:960px;">
      <div class="sec-head reveal">
        <span class="eyebrow" set:html={h.where} />
        <h2 class="display-l"><a href={h.href} style="color:inherit; text-decoration:none;">{h.name}</a></h2>
      </div>
      <p class="body-2 reveal" style="max-width:62ch;" set:html={h.take} />
      <div class="villa-table reveal" role="table" aria-label={`${h.name} villas`}>
        <div class="vt-row vt-head" role="row"><span role="columnheader">Villa</span><span role="columnheader">Sleeps</span><span role="columnheader">Size</span><span role="columnheader">Notes</span></div>
        {h.villas.map(([n, s, z, note]) => (
          <div class="vt-row" role="row"><span role="cell" class="vt-name" set:html={n} /><span role="cell" set:html={s} /><span role="cell" set:html={z} /><span role="cell" set:html={note} /></div>
        ))}
      </div>
    </div>
  </section>
))}

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="photos reveal">
      <figure><img src="/images/hotels/andronis-villas/arcadia-eden-villa.jpg" alt="The Eden Villa and its private pool among the white buildings of Andronis Arcadia, Santorini" width="1080" height="546" loading="lazy" decoding="async" /><figcaption>Eden Villa, Andronis Arcadia</figcaption></figure>
      <figure><img src="/images/hotels/andronis-villas/boutique-two-bedroom.jpg" alt="A bedroom with caldera views and a hot tub in the Two Bedroom Villa at Andronis Boutique, Oia" width="1800" height="1200" loading="lazy" decoding="async" /><figcaption>Two Bedroom Villa, Andronis Boutique</figcaption></figure>
    </div>
  </div>
</section>

<section class="section band on-shadow">
  <div class="container" style="max-width:860px;">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">How I&rsquo;d choose</span>
    <h2 class="display-l reveal">Which Andronis villa, for which trip</h2>
    <ul class="why reveal">
      <li><b>A big family or two families:</b> the Eden Villa or the Four Bedroom Villa at Arcadia, with the kids club down the path.</li>
      <li><b>A wellness trip or a longer stay:</b> one of the three-bedroom villas at Concept, close to the Kallos Spa.</li>
      <li><b>A honeymoon or anniversary:</b> the Sunset Villas at Luxury Suites, with dinner at Lycabettus.</li>
      <li><b>First time in Santorini, small family:</b> the Two Bedroom Villa at Boutique or Luxury Suites, right in Oia.</li>
      <li><b>Comparing with Canaves?</b> See my <a href="/canaves-epitome-villas-santorini.html">Canaves Epitome villas</a>, my pick for the best family villa on the island, and <a href="/canaves-vs-andronis.html">Canaves vs. Andronis</a>.</li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:820px;">
    <div class="sec-head reveal">
      <span class="eyebrow">Before you ask</span>
      <h2 class="display-l">The questions I get</h2>
    </div>
    <div class="faq reveal">
      {faq.map(([q, a]) => (
        <details>
          <summary set:html={q} />
          <p class="body-2" set:html={a} />
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section inquire band on-shadow" id="inquire" style="scroll-margin-top:70px;">
  <div class="container">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">The Andronis Villas</span>
    <h2 class="display-l reveal">When are you thinking?</h2>
    <p class="deck reveal" style="margin:18px auto 0; max-width:44ch;">Tell me your dates, who&rsquo;s coming and the occasion. I&rsquo;ll check the villas across all four hotels and plan the rest of Greece around them.</p>
    <form class="inquire-form reveal" action="https://formspree.io/f/mjgnadov" method="POST">
      <input type="hidden" name="_subject" value="Andronis villa inquiry" />
      <input type="hidden" name="hotel" value="Andronis Villas, Santorini" />
      <input type="hidden" name="page" value="andronis-villas-santorini" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="step1">
        <label for="q-when" style="color:var(--band-ash);">When are you thinking?</label>
        <input id="q-when" type="text" name="travel_dates" placeholder="June 2027 · 5 nights · 8 guests" required autocomplete="off" />
      </div>
      <div class="step2">
        <label for="q-name" style="color:var(--band-ash);">And where do I send the plan?</label>
        <input id="q-name" type="text" name="name" placeholder="Name" required autocomplete="name" />
        <input id="q-email" type="email" name="email" placeholder="Email" required autocomplete="email" />
        <label for="q-details" style="margin-top:2px; color:var(--band-ash);">Anything else? Occasion, kids&rsquo; ages, the rest of the trip (optional)</label>
        <input id="q-details" type="text" name="details" placeholder="Anniversary · then Paros and Athens" autocomplete="off" />
      </div>
      <button type="submit" class="btn" data-gtag-label="villa_inquiry_send" data-gtag-location="villa_cta">Send</button>
      <p class="note" style="color:var(--band-ash);">Traveling within the next 30 days? You&rsquo;ll hear from me today.</p>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

</Layout>

<style>
  .photos img { aspect-ratio: 3/2; }
  .villa-table { margin-top: 28px; border-top: 1px solid var(--hairline-firm); }
  .vt-row { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--hairline); font-size: .95rem; }
  .vt-head { display: none; }
  .vt-name { font-family: var(--display); font-size: 1.1rem; }
  @media (min-width: 760px) {
    .vt-row { grid-template-columns: 2.2fr .8fr 1.3fr 2fr; gap: 20px; align-items: baseline; }
    .vt-head { display: grid; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ash); }
  }
  .why { margin-top: 24px; padding-left: 1.1em; max-width: 62ch; }
  .why li { margin-top: 12px; line-height: 1.6; }
  .why a { color: inherit; }
  .faq details { border-top: 1px solid var(--hairline); padding: 18px 0; }
  .faq details:last-child { border-bottom: 1px solid var(--hairline); }
  .faq summary { cursor: pointer; font-family: var(--display); font-size: 1.2rem; list-style: none; position: relative; padding-right: 28px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; position: absolute; right: 0; top: 0; color: var(--brass); font-family: var(--body); }
  .faq details[open] summary::after { content: "\2013"; }
  .faq details p { margin-top: 12px; max-width: 62ch; }
</style>
