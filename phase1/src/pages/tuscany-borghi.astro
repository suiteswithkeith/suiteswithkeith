---
// Three-way comparison of the Tuscan borghi — the landing page for the
// San Felice / Pignano / Il Borro Instagram carousel.
import Layout from '../layouts/Layout.astro';

const T = '/images/tuscany/';
const borghi = [
  {
    id: 'borgo-san-felice', name: 'Borgo San Felice', short: 'San Felice',
    choose: 'If you want the all-rounder',
    lead: 'The most well-rounded of the three, close to Siena. Fantastic service, fantastic food, and a real feeling of home.',
    img: T + 'borgo-san-felice-chapel-pines.jpg', w: 1600, h: 783,
    alt: 'The chapel and umbrella pines at Borgo San Felice at sunset',
    eyebrow: 'Near Siena &middot; Chianti', stamp: 'Stayed &middot; Fora Reserve',
    tag: 'The most well-rounded. It just feels like home.',
    body: 'A perfectly restored medieval hamlet in the Chianti hills just outside Siena, run as one hotel. Of every borgo I&rsquo;ve stayed at and visited, it&rsquo;s the one that gets everything right &mdash; the service, the food, the restoration &mdash; and it&rsquo;s one of my favorite stays so far.',
    facts: [['Where', 'Chianti, just outside Siena'], ['Best for', 'Almost anyone: couples, first-timers, anyone who wants Siena close by'], ['On property', 'Tennis, gym and spa'], ['Don&rsquo;t miss', 'Summer dinner in the piazza, in front of the chapel']],
    review: '/hotels/borgo-san-felice-tuscany.html',
  },
  {
    id: 'borgo-pignano', name: 'Borgo Pignano', short: 'Pignano',
    choose: 'If you want the countryside',
    lead: 'The country stay, with the best pool of the three. Great for couples, with private villas for families and groups.',
    img: T + 'borgo-pignano-pool.jpg', w: 1600, h: 1067,
    alt: 'The infinity pool at Borgo Pignano, cut into the hillside above the woods and the valley',
    eyebrow: 'Outside Volterra', stamp: 'Stayed &middot; Relais &amp; Ch&acirc;teaux &middot; Fora Reserve',
    tag: 'The country stay, with the best pool of the three.',
    body: 'A villa and stone hamlet on a hilltop outside Volterra &mdash; close to a farm stay, and a bit remote in the best way. The pool is cut into the hillside facing the valley, dinner is served under a pergola at sunset, and around nine private villas make it the pick for families and groups.',
    facts: [['Where', 'The hills outside Volterra, about 1.5 hours from Florence'], ['Best for', 'Couples who want quiet; families and groups taking a villa'], ['On property', 'The best pool of the three, a kids&rsquo; pool, tennis, gym and spa'], ['Don&rsquo;t miss', 'Dinner under the pergola at sunset']],
    review: '/hotels/borgo-pignano-volterra-tuscany.html',
  },
  {
    id: 'il-borro', name: 'Il Borro', short: 'Il Borro',
    choose: 'If it&rsquo;s your honeymoon',
    lead: 'The most authentic of the three: the Ferragamo family&rsquo;s medieval village, where the whole borgo is the hotel.',
    img: T + 'il-borro-village-lane.jpg', w: 1024, h: 768,
    alt: 'Stone and pink houses with flower boxes along a lane in the Il Borro borgo',
    eyebrow: 'Valdarno &middot; between Florence &amp; Arezzo', stamp: 'Toured &middot; Relais &amp; Ch&acirc;teaux &middot; Fora Reserve',
    tag: 'The most authentic, and the honeymoon pick.',
    body: 'An entire medieval village restored by the Ferragamo family and run as one estate &mdash; it reminded me of Aman Sveti Stefan in its layout, because you sleep inside the borgo rather than looking at it. Honeymooners belong in the original village; more modern rooms are a two-minute drive away.',
    facts: [['Where', 'The Valdarno hills, between Florence and Arezzo'], ['Best for', 'Honeymooners in the borgo; travelers who want a modern room nearby'], ['On property', 'Stunning pools, and the whole village'], ['Worth knowing', 'Rates are competitive for the level']],
    review: '/hotels/il-borro-tuscany.html',
  },
];

const rows = [
  ['Where', 'Near Siena', 'Outside Volterra', 'Valdarno'],
  ['The feel', 'Warm &mdash; it feels like home', 'Country &mdash; a bit remote', 'The most authentic'],
  ['Best for', 'Almost anyone', 'Couples, families &amp; groups', 'Honeymooners'],
  ['The pool', '&mdash;', 'Best of the three', 'Stunning'],
  ['On property', 'Tennis, gym, spa', 'Tennis, gym, spa, kids&rsquo; pool, villas', 'The whole village'],
  ['My visit', 'Stayed', 'Stayed', 'Toured'],
  ['Booking', 'Fora Reserve', 'Relais &amp; Ch&acirc;teaux, Fora Reserve', 'Relais &amp; Ch&acirc;teaux, Fora Reserve'],
];

const pairs = [
  { href: '/borgo-san-felice-vs-borgo-pignano.html', label: 'Borgo San Felice <em>or</em> Borgo Pignano', q: 'Village life near Siena, or the countryside with the best pool of the three?' },
  { href: '/borgo-san-felice-vs-il-borro.html', label: 'Borgo San Felice <em>or</em> Il Borro', q: 'The well-rounded borgo that feels like home, or the once-in-a-lifetime honeymoon village?' },
  { href: '/borgo-pignano-vs-il-borro.html', label: 'Borgo Pignano <em>or</em> Il Borro', q: 'A country stay with private villas, or an entire medieval village of your own?' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Borgo San Felice, Borgo Pignano or Il Borro?',
  description: 'Three Tuscan borghi compared side by side by Keith Pence.',
  image: 'https://suiteswithkeith.com' + borghi[0].img,
  author: { '@type': 'Person', name: 'Keith Pence' },
  publisher: { '@type': 'Organization', name: 'Suites With Keith', logo: { '@type': 'ImageObject', url: 'https://suiteswithkeith.com/favicon-32.png' } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://suiteswithkeith.com/tuscany-borghi.html' },
});
---
<Layout
  canonical="tuscany-borghi.html"
  title="Borgo San Felice vs Borgo Pignano vs Il Borro | Suites With Keith"
  description="Three restored Tuscan borghi, three different trips: Borgo San Felice near Siena, Borgo Pignano outside Volterra and Il Borro in the Valdarno, compared side by side by an advisor who stayed and toured. Which one is yours, plus Fora Reserve perks."
  preload={borghi[0].img}
  current="rankings"
>

<Fragment slot="head" set:html={`<script type="application/ld+json">${schema}</script>`} />

<!-- masthead -->
<header class="section" style="padding-bottom:0;">
  <div class="container">
    <p class="eyebrow reveal">Head-to-head-to-head &middot; Tuscany</p>
    <h1 class="display-xl reveal tb-h1">Borgo San Felice, Borgo Pignano <em style="font-style:italic; color:var(--brass);">or Il Borro?</em></h1>
    <p class="deck reveal" style="margin-top:22px; max-width:50ch;">Three restored medieval borghi, three completely different trips &mdash; and all three are fantastic. Here&rsquo;s which one is yours.</p>
    <p class="stamp reveal" style="margin-top:26px;">Stayed at San Felice &amp; Pignano &middot; toured Il Borro &middot; all three Fora Reserve</p>
  </div>
</header>

<!-- the short answer -->
<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">The short answer</span>
      <h2 class="display-l">Which one is yours?</h2>
    </div>
    <div class="choose tb-choose">
      {borghi.map((b) => (
        <a class="choose-col tb-col reveal" href={`#${b.id}`}>
          <figure style="margin:0 0 22px;"><img src={b.img} alt={b.alt} width={b.w} height={b.h} loading="lazy" decoding="async" style="aspect-ratio:3/2; object-fit:cover; width:100%;" /></figure>
          <span class="eyebrow" set:html={`Choose ${b.name}`} />
          <h3 set:html={b.choose} />
          <p class="lead" set:html={b.lead} />
          <span class="tb-go">Why &darr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- borgo by borgo -->
{borghi.map((b, i) => (
  <section class={`section${i === 1 ? ' band on-shadow' : ''}`} id={b.id} style="scroll-margin-top:70px;">
    <div class="container tb-borgo">
      <figure class="reveal" style="margin:0;"><img src={b.img} alt={b.alt} width={b.w} height={b.h} loading="lazy" decoding="async" style="width:100%; aspect-ratio:4/3; object-fit:cover;" /></figure>
      <div class="reveal">
        <span class="eyebrow" set:html={b.eyebrow} />
        <h2 class="display-l" style="margin-top:12px;" set:html={b.name} />
        <p class="tb-tag" set:html={b.tag} />
        <p class="body-2" style="margin-top:16px;" set:html={b.body} />
        <dl class="kv tb-facts">
          {b.facts.map(([k, v]) => <div class="kv-row"><dt set:html={k} /><dd set:html={v} /></div>)}
        </dl>
        <p class="stamp" style="margin-top:22px;" set:html={b.stamp} />
        <p style="margin-top:20px;"><a class={`btn btn-ghost${i === 1 ? ' on-shadow' : ''}`} href={b.review}>Read my full review</a></p>
      </div>
    </div>
  </section>
))}

<!-- the table -->
<section class="section">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Side by side</span>
      <h2 class="display-l">How they compare</h2>
    </div>
    <div class="table-wrap reveal">
      <table>
        <thead><tr><th></th>{borghi.map((b) => <th set:html={b.name} />)}</tr></thead>
        <tbody>
          {rows.map(([label, ...cells]) => (
            <tr><td class="rowlabel" set:html={label} />{cells.map((c) => <td set:html={c} />)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- the verdict -->
<section class="section band on-shadow">
  <div class="container" style="max-width:860px;">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">The question behind the question</span>
    <h2 class="display-l reveal">Who&rsquo;s coming decides it.</h2>
    <p class="body-2 reveal" style="margin-top:22px; max-width:56ch;">On a honeymoon, book <a href="#il-borro" style="color:var(--brass-lit);">Il Borro</a> and sleep in the original borgo. It&rsquo;s the most authentic stay in Tuscany, and the way the whole village is the hotel reminded me of Aman Sveti Stefan.</p>
    <p class="body-2 reveal" style="margin-top:18px; max-width:56ch;">Bringing family or friends, or craving real countryside? <a href="#borgo-pignano" style="color:var(--brass-lit);">Borgo Pignano</a> &mdash; private villas, a remote farm-stay feel, and the best pool of the three.</p>
    <p class="body-2 reveal" style="margin-top:18px; max-width:56ch;">Everyone else, and anyone who simply wants it all done well: <a href="#borgo-san-felice" style="color:var(--brass-lit);">Borgo San Felice</a>. It&rsquo;s the most well-rounded, it&rsquo;s close to Siena, and it&rsquo;s one of my favorite stays so far.</p>
  </div>
</section>

<!-- perks -->
<section class="section">
  <div class="container" style="max-width:820px; text-align:center;">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">Book through me</span>
    <h2 class="display-l reveal">Same rate &mdash; sometimes better.<br>Never the same welcome.</h2>
    <p class="body-2 reveal" style="margin:22px auto 0; max-width:54ch;">All three are Fora Reserve, so booking any of them through me adds a space-available upgrade, daily breakfast and a hotel credit &mdash; plus my direct line to the team on property. You pay the same rate as booking direct.</p>
  </div>
</section>

<!-- the pairs -->
<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Down to two?</span>
      <h2 class="display-l" style="font-size:clamp(1.6rem,3.2vw,2.3rem);">The one-on-one comparisons</h2>
    </div>
    <div class="vsi-grid">
      {pairs.map((v) => (
        <a class="vsi-tile reveal" href={v.href}>
          <span class="vsi-names" set:html={v.label} />
          <span class="vsi-q" set:html={v.q} />
          <span class="vsi-go">Settle it &rarr;</span>
        </a>
      ))}
    </div>
    <p class="reveal" style="margin-top:28px;"><a href="/tuscany.html" style="font-size:.74rem; font-weight:500; letter-spacing:.14em; text-transform:uppercase; color:var(--brass); text-decoration:none;">My full Tuscany guide &rarr;</a></p>
  </div>
</section>

<!-- the ask -->
<section class="section inquire band on-shadow" id="inquire" style="scroll-margin-top:70px;">
  <div class="container">
    <span class="eyebrow reveal" style="display:block; margin-bottom:16px;">Not sure which borgo is yours?</span>
    <h2 class="display-l reveal">When are you thinking?</h2>
    <p class="deck reveal" style="margin:18px auto 0; max-width:42ch;">Send me your dates and who&rsquo;s traveling. I&rsquo;ll tell you which borgo, and the room I&rsquo;d book.</p>
    <form class="inquire-form reveal" action="https://formspree.io/f/mjgnadov" method="POST">
      <input type="hidden" name="_subject" value="Tuscany borghi inquiry: San Felice / Pignano / Il Borro" />
      <input type="hidden" name="hotel" value="Borgo San Felice / Borgo Pignano / Il Borro" />
      <input type="hidden" name="page" value="tuscany-borghi" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="step1">
        <label for="q-when" style="color:var(--band-ash);">When are you thinking?</label>
        <input id="q-when" type="text" name="travel_dates" placeholder="June, 5 nights" required autocomplete="off" />
      </div>
      <div class="step2">
        <fieldset class="tb-lean">
          <legend style="color:var(--band-ash);">I&rsquo;m leaning toward</legend>
          {['Borgo San Felice', 'Borgo Pignano', 'Il Borro', 'Help me decide'].map((o) => (
            <label class="tb-chip"><input type="checkbox" name="leaning_toward" value={o} /><span>{o}</span></label>
          ))}
        </fieldset>
        <label for="q-name" style="color:var(--band-ash);">And where do I send the recommendation?</label>
        <input id="q-name" type="text" name="name" placeholder="Name" required autocomplete="name" />
        <input id="q-email" type="email" name="email" placeholder="Email" required autocomplete="email" />
        <label for="q-details" style="margin-top:2px; color:var(--band-ash);">Anything else? Occasion, who&rsquo;s coming &mdash; optional</label>
        <input id="q-details" type="text" name="details" placeholder="Honeymoon &middot; 2 adults" autocomplete="off" />
      </div>
      <button type="submit" class="btn" data-gtag-label="borghi_inquiry_send" data-gtag-location="borghi_compare">Send</button>
      <p class="note" style="color:var(--band-ash);">Traveling within the next 30 days? You&rsquo;ll hear from me today.</p>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

</Layout>

<style is:global>
  .tb-h1 { margin-top: 18px; max-width: 20ch; font-size: clamp(2rem, 5.2vw, 3.4rem); }
  @media (min-width: 1000px) { .tb-choose { grid-template-columns: repeat(3, 1fr); } }
  .tb-col { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); transition: transform .25s ease, box-shadow .25s ease; }
  @media (hover:hover) { .tb-col:hover { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(22,23,18,.07), 0 18px 40px rgba(22,23,18,.10); } }
  .tb-col .lead { flex: 1; }
  .tb-go { margin-top: 16px; font-size: .68rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--brass); }

  .tb-borgo { display: grid; gap: 36px; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .tb-borgo { grid-template-columns: 1fr 1.1fr; gap: 64px; } }
  .tb-borgo > * { min-width: 0; }
  .tb-tag { font-family: var(--display); font-style: italic; font-size: clamp(1.15rem, 2.2vw, 1.4rem); line-height: 1.4; margin-top: 14px; color: var(--brass); }
  .band .tb-tag { color: var(--brass-lit); }
  .tb-facts { margin-top: 22px; }
  .tb-facts .kv-row { padding: 10px 0; }
  .band .tb-facts .kv-row { border-bottom-color: var(--band-hairline); }
  .band .tb-facts { border-top-color: var(--band-hairline); }
  .band .tb-facts dt { color: var(--band-ash); }
  .band .body-2 { color: var(--band-ash); }

  .vsi-grid { display: grid; gap: 22px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .vsi-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .vsi-grid { grid-template-columns: repeat(3, 1fr); } }
  .vsi-tile { background: var(--lime); border: 1px solid var(--hairline); padding: clamp(22px, 3vw, 30px); display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); transition: transform .25s ease, box-shadow .25s ease; }
  @media (hover:hover) { .vsi-tile:hover { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(22,23,18,.07), 0 18px 40px rgba(22,23,18,.10); } }
  .vsi-names { font-family: var(--display); font-weight: 500; font-size: 1.25rem; line-height: 1.3; }
  .vsi-names em { font-style: italic; color: var(--brass); font-weight: 400; }
  .vsi-q { font-size: .9rem; color: var(--ash); line-height: 1.6; flex: 1; }
  .vsi-go { font-size: .68rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--brass); padding-top: 6px; }

  .tb-lean { border: 0; padding: 0; margin: 0 0 6px; display: flex; flex-wrap: wrap; gap: 8px; }
  .tb-lean legend { font-size: .7rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 10px; padding: 0; }
  .tb-chip { position: relative; cursor: pointer; }
  .tb-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tb-chip span { display: inline-block; padding: 8px 14px; border: 1px solid var(--band-hairline); color: var(--band-ink); font-size: .8rem; transition: background .2s, border-color .2s; }
  .tb-chip input:checked + span { background: var(--brass-lit); border-color: var(--brass-lit); color: var(--shadow); }
  .tb-chip input:focus-visible + span { outline: 2px solid var(--brass-lit); outline-offset: 2px; }
</style>
